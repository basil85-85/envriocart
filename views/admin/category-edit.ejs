               <script>
                    async function validateAndSubmit(e) {
                      e.preventDefault(); 
                  
                    
                      const name = document.getElementById('category-title').value.trim();
                      const description = document.getElementById('description').value.trim();
                        
                         let isValid = true;
                         if (name.length === 0) {
                              showError("error-message-title", "Category Name is required.");
                              isValid = false;
                         } else if (name.length < 2 || name.length > 30) {
                              showError("error-message-title", "Category title must be between 2 and 30 characters.");
                              isValid = false;
                         }
                         else{
                              clearError("error-message-title")
                         }


                         if (description.length === 0) {
                              showError("error-message-description", "Category description is required.");
                              isValid = false;
                         } else if (description.length < 10 || description.length > 300) {
                              showError("error-message-description", "Description must be between 10 and 300 characters.");
                              isValid = false;
                         }
                         else{
                              clearError("error-message-description")
                         }

                         if (!isValid) {
                              return; 
                         }
                      
                      const formData = { name, description };
                  
                      try {
                       
                        const response = await fetch(`/admin/categoryedit?id=<%= findCategory._id %>`, {
                          method: 'PUT',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify(formData),
                        });
                  
                     
                        if (response.ok) {
                          showSuccessNotification('Category updated successfully!');
                         
                        } else {
                          const errorData = await response.json();
                          showErrorNotification(`Error: ${errorData.message || 'Failed to update category'}`);
                        }
                      } catch (error) {
                        // Handle any network or unexpected errors
                        console.error('Error:', error);
                        alert('An unexpected error occurred. Please try again.');
                      }
                    }


                    

function showSuccessNotification(message) {
            Swal.fire({
                title: 'Success',
                text: message,
                icon: 'success',
                position: 'top',
                toast: true,
                showConfirmButton: false,
                timer: 1500,
                timerProgressBar: true,
                showClass: {
                    popup: 'animate__animated animate__fadeInDown'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp'
                },
                background: '#fff',
                color: '#1a1a1a',
                iconColor: '#4CAF50',
                customClass: {
                    popup: 'premium-toast',
                    title: 'premium-title',
                    timerProgressBar: 'premium-progress'
                }
    })
                    .then(()=>{
                         window.location.href = '/admin/category';   
                                        })
                    
}


                    // Error notification function
                    function showErrorNotification(message) {
                    Swal.fire({
                         title: 'Error',
                         text: message || 'Verification failed',
                         icon: 'error',
                         position: 'top',
                         toast: true,
                         showConfirmButton: false,
                         timer: 3000,
                         timerProgressBar: true,
                         showClass: {
                              popup: 'animate__animated animate__shakeX'
                         },
                         hideClass: {
                              popup: 'animate__animated animate__fadeOutUp'
                         },
                         background: '#fff',
                         color: '#1a1a1a',
                         iconColor: '#FF3B30',
                         customClass: {
                              popup: 'premium-error-toast',
                              title: 'premium-error-title',
                              timerProgressBar: 'premium-error-progress'
                         }
                    });
                    }


                    
     function showError(id, message) {
         const errorElement = document.getElementById(id);
         if (errorElement) {
             errorElement.textContent = message;
             errorElement.style.color = 'red';
         }
     }
     function clearError(id) {
         const errorElement = document.getElementById(id);
         if (errorElement) {
             errorElement.textContent = '';
         }
     }

                  </script>
                  

