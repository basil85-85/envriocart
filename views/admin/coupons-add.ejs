                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Coupon Information</h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label for="coupon-code" class="form-label">Coupon Code</label>
                                    <input type="text" id="coupon-code" name="coupon-code" class="form-control" placeholder="Enter Code">
                                </div>
                                <span id="error-code"></span>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label for="min-cart" class="form-label">Minimum Cart Limit</label>
                                    <input type="number" id="min-cart" name="min-cart" class="form-control" placeholder="Enter limit">
                                </div>
                                <span id="error-min"></span>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label for="coupon-limits" class="form-label">Coupon Limits</label>
                                    <input type="number" id="coupon-limits" name="coupon-limits" class="form-control" placeholder="Enter limit">
                                </div>
                                <span id="error-couponlimit"></span>
                            </div>
                        </div>
                
                        <h4 class="card-title mb-3 mt-2">Coupon Type</h4>
                        <div class="row mb-3">
                            <div class="col-lg-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="couponType" id="percentage" checked>
                                    <label class="form-check-label" for="percentage">Percentage</label>
                                </div>
                                <span id="error-percentage"></span>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="couponType" id="fixedAmount">
                                    <label class="form-check-label" for="fixedAmount">Fixed Amount</label>
                                </div>
                                <span id="error-amount"></span>
                            </div>
                            <div class="col-lg-4">
                                <label for="discount-value">Discount Value</label>
                                <input type="number" id="discount-value" class="form-control" placeholder="Enter amount or percentage">
