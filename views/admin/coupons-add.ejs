            </div>
            <script>
               flatpickr("#start-date", {
                   dateFormat: "d-m-Y",  // Format as dd-mm-yyyy
                   enableTime: false,    // Only date selection
                   allowInput: true,     // Allow manual input
               });
               flatpickr("#end-date", {
                   dateFormat: "d-m-Y",  // Format as dd-mm-yyyy
                   enableTime: false,    // Only date selection
                   allowInput: true,     // Allow manual input
               });
           </script>
            <script>
              // Utility functions for handling form errors
const showError = (elementId, message) => {
    const errorElement = document.getElementById(`error-${elementId}`);
    if (errorElement) {
        errorElement.textContent = message;
        errorElement.style.color = 'red';
        // Optional: highlight the input field
        const inputElement = document.getElementById(elementId);
        if (inputElement) {
            inputElement.classList.add('is-invalid');
        }
    }
    return false;
};

const clearError = (elementId) => {
    const errorElement = document.getElementById(`error-${elementId}`);
    if (errorElement) {
        errorElement.textContent = '';
        // Optional: remove highlight from input field
        const inputElement = document.getElementById(elementId);
        if (inputElement) {
            inputElement.classList.remove('is-invalid');
        }
    }
    return true;
};

// Function to validate the coupon form
const validateCouponForm = () => {
    let isValid = true;

    // Get form values
    const code = document.getElementById('coupon-code').value;
    const startDate = document.getElementById('start-date').value;
    const endDate = document.getElementById('end-date').value;
    const minCart = document.getElementById('min-cart').value;
    const couponLimits = document.getElementById('coupon-limits').value;
    const discountValue = document.getElementById('discount-value').value;
    const discountType = document.getElementById('percentage').checked ? 'percentage' : 'fixed';

    // Validate Coupon Code
    if (!code || code.trim().length < 3) {
        isValid = showError('code', 'Coupon code must be at least 3 characters');
    } else {
        clearError('code');
    }

    // Validate Dates
    if (!startDate) {
        isValid = showError('date', 'Start date is required');
    } else if (!endDate) {
        isValid = showError('date', 'End date is required');
    } else if (new Date(endDate) < new Date(startDate)) {
        isValid = showError('date', 'End date must be after start date');
    } else {
        clearError('date');
    }

    // Validate Minimum Cart Value
    if (!minCart || minCart <= 0) {
        isValid = showError('min', 'Please enter a valid minimum cart value');
    } else {
        clearError('min');
    }

    // Validate Coupon Limits
    if (!couponLimits || couponLimits <= 0) {
        isValid = showError('couponlimit', 'Please enter a valid coupon limit');
    } else {
        clearError('couponlimit');
    }

    // Validate Discount Value
    if (!discountValue || discountValue <= 0) {
        isValid = showError('value', 'Please enter a valid discount value');
    } else if (discountType === 'percentage' && discountValue > 100) {
        isValid = showError('value', 'Percentage cannot be more than 100');
    } else {
        clearError('value');
    }

    return isValid;
};

// Main function to handle coupon creation
async function addCoupon(event) {
    event.preventDefault();

    // Validate form
    if (!validateCouponForm()) {
        return;
    }

    // Get form data
    const formData = {
        status: document.getElementById('activeStatus').checked ? 'active' : 'inactive',
        startDate: document.getElementById('start-date').value,
        endDate: document.getElementById('end-date').value,
        code: document.getElementById('coupon-code').value,
        minCartValue: Number(document.getElementById('min-cart').value),
        couponLimits: Number(document.getElementById('coupon-limits').value),
        discountType: document.getElementById('percentage').checked ? 'percentage' : 'fixed',
        discountValue: Number(document.getElementById('discount-value').value)
    };

    try {
        const response = await fetch('/admin/coupon/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (!response.ok) {
           showErrorNotification(data.message)
        }

        // Clear all errors on success
        ['code', 'date', 'min', 'couponlimit', 'value'].forEach(clearError);
        
        // Reset form
        document.getElementById('couponForm').reset();
        
        if(data.success){
          showSuccessNotification(data.message)
        }
        else{
          showErrorNotification(data.message)
        }
       

    } catch (error) {
        // Show general error
        showErrorNotification( error.message);
    }
}

// Add event listeners for real-time validation
document.getElementById('coupon-code').addEventListener('input', () => {
    const code = document.getElementById('coupon-code').value;
    if (code && code.trim().length >= 3) {
        clearError('code');
    }
});

document.getElementById('min-cart').addEventListener('input', () => {
    const value = document.getElementById('min-cart').value;
    if (value > 0) {
        clearError('min');
    }
});

document.getElementById('coupon-limits').addEventListener('input', () => {
    const value = document.getElementById('coupon-limits').value;
    if (value > 0) {
        clearError('couponlimit');
    }
});

document.getElementById('discount-value').addEventListener('input', () => {
    const value = document.getElementById('discount-value').value;
    const isPercentage = document.getElementById('percentage').checked;
    
    if (value > 0 && (!isPercentage || value <= 100)) {
        clearError('value');
    }
});



function showSuccessNotification(message) {
            Swal.fire({
                title: 'Success',
                text: message||"sucessfully created",
                icon: 'success',
                position: 'top',
                toast: true,
                showConfirmButton: false,
                timer: 1500,
                timerProgressBar: true,
                showClass: {
                    popup: 'animate__animated animate__fadeInDown'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp'
                },
                background: '#fff',
                color: '#1a1a1a',
                iconColor: '#4CAF50',
                customClass: {
                    popup: 'premium-toast',
                    title: 'premium-title',
                    timerProgressBar: 'premium-progress'
                }
    }).then(() => {
        window.location.href = '/admin/coupon';
    });
}

function showErrorNotification(message) {
    Swal.fire({
        title: 'Error',
        text: message || 'Verification failed',
        icon: 'error',
        position: 'top',
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        showClass: {
            popup: 'animate__animated animate__shakeX'
        },
        hideClass: {
            popup: 'animate__animated animate__fadeOutUp'
        },
        background: '#fff',
        color: '#1a1a1a',
        iconColor: '#FF3B30',
        customClass: {
            popup: 'premium-error-toast',
            title: 'premium-error-title',
            timerProgressBar: 'premium-error-progress'
        }
    });
} 

            </script>
