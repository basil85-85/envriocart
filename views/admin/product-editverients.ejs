    /* Container for all uploaders */
.upload-container {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 20px;
}

/* Individual upload card */
.upload-card {
    flex: 0 0 auto;
    width: 250px; /* Fixed width for each uploader */
}

/* Upload zone styling */
.image-upload-area {
    border: 2px dashed #ccc;
    padding: 15px;
    text-align: center;
    cursor: pointer;
    margin-bottom: 10px;
    min-height: 150px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.image-upload-area.dragover {
    border-color: #2196F3;
    background: #E3F2FD;
}

.upload-icon {
    width: 36px;
    height: 36px;
    margin-bottom: 8px;
}

.upload-text {
    margin: 0;
    font-size: 0.875rem;
}

/* Preview container */
.preview-container {
    display: none;
    margin-top: 10px;
}

.img-preview {
    max-width: 100%;
    height: auto;
    margin-bottom: 10px;
}

/* Cropped result */
.cropped-result {
    display: none;
    max-width: 100%;
    height: auto;
    margin-top: 10px;
    border-radius: 4px;
}

/* Error message */
.error-message {
    color: red;
    display: none;
    margin-top: 5px;
    font-size: 0.875rem;
}

/* Loading spinner */
.spinner {
    display: none;
    width: 16px;
    height: 16px;
    border: 2px solid #f3f3f3;
    border-top: 2px solid #3498db;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-left: 8px;
    display: inline-block;
    vertical-align: middle;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Button styling */
.remove-image {
    margin-top: 8px;
    width: 100%;
}

/* Status message */
.upload-status {
    margin-top: 5px;
    font-size: 0.875rem;
}

.upload-status .success {
    color: #28a745;
}

.upload-status .error {
    color: #dc3545;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .upload-container {
        flex-direction: column;
    }
    
    .upload-card {
        width: 100%;
    }
}
   </style>
