                                                        <h3>Size Selection</h3>
                                                    </div>
                                                
                                                    <div class="size-grid">
                                                        <% Object.entries(verient.size).forEach(([size, quantity]) => { %>
                                                            <div class="size-item">
                                                                <input type="checkbox" id="size-<%= size %>" name="sizes[]" value="<%= size %>">
                                                                <label for="size-<%= size %>"><%= size %></label>
                                                                <input type="number" name="sizeQty[<%= size %>]" class="quantity-input" min="0" value="<%= quantity %>" placeholder="Qty">
                                                            </div>
                                   
                                                        <% }) %>
                                                    </div>
                                                </div>
                                                
                                                <div id="error-message-size" class="error-message"></div>
                                            </div>
                                        </div>
                                </div>
                              
