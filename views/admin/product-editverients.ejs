           <script src="/assets/js/app.js"></script>
           <script>
                       
                function formSubmit(event) {
                    event.preventDefault();
                    const sizeItems = document.querySelectorAll('.size-item');
                    let isValid = true;
                    
                    clearError("error-message-size")
                    let hasSelectedSize = false
                    sizeItems.forEach(sizeItem => {
                        const checkbox = sizeItem.querySelector('input[type="checkbox"]');
                        const quantityInput = sizeItem.querySelector('.quantity-input');
                        if (checkbox.checked) {
                            hasSelectedSize = true
                            if (quantityInput.value < 0 || quantityInput.value === '') {
                                showError("error-message-size", "Please enter a valid quantity");
                                isValid = false;
                            }
                            else if(!Number(quantityInput.value) > 0) {
                                showError("error-message-size", "Please enter a valid quantity");
                                isValid = false;
                                }
                            
                        }
                    });
                    
                    
                    if (!hasSelectedSize) {
                        showError("error-message-size", "Please select at least one size");
                        return;
                    }
                    

                    //image verification
                    let imagesValid = true;
                    let imageData = [];
                    const croppedImages = document.querySelectorAll('[id^="croppedResult"]');
                    croppedImages.forEach((img, index) => {
                        if (!img.src || img.src === window.location.href) {
                            showError("error-message-images", `Please upload and crop image ${index + 1}`);
                            imagesValid = false;
                        } else {
                            imageData.push(img.src);
                        }
                    });

                    if (!imagesValid) {
                        showError("error-message-images", "Please upload and crop all images.");
                        isValid = false;
                    } else {
                        clearError("error-message-images");
                    }

                    if (isValid) {
                        const formData = new FormData(document.getElementById('variantForm'));
                        
                        fetch('/admin/product/verient?id=<%=verient.productId.productName%>', {
                            method: 'PUT',
                            body: formData,
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                window.location.href = "/admin/product/view?id=<%= verient.productId._id %>";
                            } else {
                                alert('Error: ' + data.message);
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('An error occurred.');
                        });
                    }
                }

                 
    
           class ImageUploader {
            constructor(index) {
            this.index = index;
            this.uploadZone = document.getElementById(`uploadZone${index}`);
            this.fileInput = document.getElementById(`fileInput${index}`);
            this.errorMessage = document.getElementById(`errorMessage${index}`);
            this.previewContainer = document.getElementById(`previewContainer${index}`);
            this.imagePreview = document.getElementById(`image-preview${index}`);
            this.cropButton = document.getElementById(`cropButton${index}`);
            this.croppedResult = document.getElementById(`croppedResult${index}`);
            this.uploadStatus = document.getElementById(`uploadStatus${index}`);
            this.spinner = document.getElementById(`spinner${index}`);
            this.cropper = null;
        
        // Initialize if elements exist
        if (this.uploadZone) {
            this.initializeEventListeners();
            this.initializeExistingImage();
        }
    }

    initializeExistingImage() {
        // If there's an existing image in croppedResult, show it and hide upload zone
        if (this.croppedResult && this.croppedResult.src && this.croppedResult.src !== 'null' && this.croppedResult.src !== 'undefined') {
            this.uploadZone.style.display = 'none';
            this.croppedResult.style.display = 'block';
            
            // Add remove button for existing image
            const removeButton = document.createElement('button');
            removeButton.className = 'btn btn-danger remove-image';
            removeButton.textContent = 'Remove';
            removeButton.onclick = () => this.removeImage();
            this.croppedResult.parentElement.appendChild(removeButton);
        }
    }

    removeImage() {
        // Clear the cropped result
        this.croppedResult.src = '';
        this.croppedResult.style.display = 'none';
        
        // Show upload zone again
        this.uploadZone.style.display = 'block';
        
        // Remove the remove button
        const removeButton = this.croppedResult.parentElement.querySelector('.remove-image');
        if (removeButton) {
            removeButton.remove();
        }

        // Clear file input
        this.fileInput.value = '';
    }

    initializeEventListeners() {
        // Click to upload
        this.uploadZone.addEventListener('click', () => this.fileInput.click());

        // File input change
        this.fileInput.addEventListener('change', (e) => this.handleFileSelect(e));

        // Drag and drop
        this.uploadZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            this.uploadZone.classList.add('dragover');
        });

        this.uploadZone.addEventListener('dragleave', () => {
            this.uploadZone.classList.remove('dragover');
        });

        this.uploadZone.addEventListener('drop', (e) => {
            e.preventDefault();
            this.uploadZone.classList.remove('dragover');
            const files = e.dataTransfer.files;
            if (files.length) {
                this.fileInput.files = files;
                this.handleFileSelect({ target: this.fileInput });
            }
        });

        // Crop button
        this.cropButton.addEventListener('click', () => this.cropImage());
    }

    handleFileSelect(event) {
        const file = event.target.files[0];
        if (!file) return;

        // Validate file type
        if (!file.type.startsWith('image/')) {
            this.showError('Please upload an image file');
            return;
        }

      
        if (file.size > 5 * 1024 * 1024) {
            this.showError('Image size should be less than 5MB');
            return;
        }

        this.clearError();
        this.showPreview(file);
    }

    showPreview(file) {
        const reader = new FileReader();
        reader.onload = (e) => {
            this.imagePreview.src = e.target.result;
            this.previewContainer.style.display = 'block';
            this.uploadZone.style.display = 'none';
            this.croppedResult.style.display = 'none';
            
            // Initialize cropper
            if (this.cropper) {
                this.cropper.destroy();
            }
            this.cropper = new Cropper(this.imagePreview, {
                aspectRatio: 1,
                viewMode: 2,
                responsive: true,
                background: true
            });
        };
        reader.readAsDataURL(file);
    }

    async cropImage() {
        if (!this.cropper) return;

        this.spinner.style.display = 'block';
        this.cropButton.disabled = true;

        try {
            const canvas = this.cropper.getCroppedCanvas({
                width: 600,
                height: 600
            });
            const blob = await new Promise(resolve => {
                canvas.toBlob(blob => resolve(blob), 'image/jpeg', 0.8);
            });
            this.croppedResult.src = canvas.toDataURL('image/jpeg');
            this.croppedResult.style.display = 'block';
            this.previewContainer.style.display = 'none';
            if (!this.croppedResult.parentElement.querySelector('.remove-image')) {
                const removeButton = document.createElement('button');
                removeButton.className = 'btn btn-danger remove-image';
                removeButton.textContent = 'Remove';
                removeButton.onclick = () => this.removeImage();
                this.croppedResult.parentElement.appendChild(removeButton);
            }

            // Update status
            this.uploadStatus.innerHTML = '<span class="success">Image cropped successfully!</span>';

        } catch (error) {
            this.showError('Error processing image');
            console.error(error);
        } finally {
            this.spinner.style.display = 'none';
            this.cropButton.disabled = false;
        }
    }

    showError(message) {
        this.errorMessage.textContent = message;
        this.errorMessage.style.display = 'block';
    }

    clearError() {
        this.errorMessage.textContent = '';
        this.errorMessage.style.display = 'none';
    }
}

// Initialize uploaders
document.addEventListener('DOMContentLoaded', () => {
    // Find all upload zones
    const uploadZones = document.querySelectorAll('.image-upload-area');
    
    // Create uploader instances for each zone
    uploadZones.forEach(zone => {
        const index = zone.id.replace('uploadZone', '');
        new ImageUploader(index);
    });
});





