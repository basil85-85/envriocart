                                                  <% }); %>
                                              <% } else { %>
                                                  <option disabled>No categories available</option>
                                              <% } %>
                                            
                                           
                                              
                                     
                                           </select>
                                           <span id="error-message-category" class="mt-1"></span>
                                       </div>
                                   </div>
           
                                   <!-- Pricing -->
                                   <div class="row mb-4">
                                       <div class="col-lg-6">
                                           <label for="regularPrice" class="form-label">Regular Price *</label>
                                           <div class="input-group">
                                               <span class="input-group-text"><i class='bx bx-dollar'></i></span>
                                               <input type="number" id="regularPrice" name="regularPrice" class="form-control" 
                                                   required min="0" step="0.01" placeholder="Enter regular price">
                                                   
                                           </div>
                                           <span id="error-message-rp" class="mt-1"></span>
                                       </div>
                                       <div class="col-lg-6">
                                           <label for="salePrice" class="form-label">Sale Price</label>
                                           <div class="input-group">
                                               <span class="input-group-text"><i class='bx bx-dollar'></i></span>
                                               <input type="number" id="salePrice" name="salePrice" class="form-control" 
                                                   min="0" step="0.01" placeholder="Enter sale price">
                                                  
                                           </div>
                                           <span id="error-message-sp" class="mt-1"></span>
                                       </div>
                                   </div>
                                   <div class="row mb-4">
                                        <div class="col-12">
                                            <label for="description" class="form-label">Description *</label>
                                            <textarea class="form-control" id="description" name="description" rows="5" required 
                                                placeholder="Enter product description"></textarea>
                                                <span id="error-message-description" class="mt-1"></span>
                                        </div>
                                    </div>
           
                                  
                                    
                                    <button class="btn btn-success" onclick="formSubmit(event)">Save</button>
                                    <a href="/admin/product" class="btn btn-danger">Cancel</a>
                                   
                                 
                       </form>
                   </div>
