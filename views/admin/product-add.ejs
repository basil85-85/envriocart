           <script>
              
              async function formSubmit(event) {
                         event.preventDefault(); // Prevent form submission

                         // Retrieve field values
                         let productName = document.getElementById("productName").value.trim();
                         let categoryName = document.getElementById("category").value;
                         let regularPrice = document.getElementById("regularPrice").value.trim();
                         let salePrice = document.getElementById("salePrice").value.trim();
                         let description = document.getElementById("description").value.trim();

                         // Validation flag
                         let isValid = true;

                         // Product Name Validation
                         if (productName.length === 0 || productName.length < 2) {
                         showError("error-message-productName", "Field is required or the product name is too short.");
                         isValid = false;
                         } else if (/\d/.test(productName)) {
                         showError("error-message-productName", "Product name should not contain numbers.");
                         isValid = false;
                         } else {
                         clearError("error-message-productName");
                         }

                         // Category Validation
                         if (categoryName === "") {
                         showError("error-message-category", "Category is required.");
                         isValid = false;
                         } else {
                         clearError("error-message-category");
                         }

                         // Regular Price Validation
                         if (regularPrice.length === 0 || parseFloat(regularPrice) < 0) {
                         showError("error-message-rp", "Field is required or the input is invalid.");
                         isValid = false;
                         } else if (!/^\d+$/.test(regularPrice)) {
                         showError("error-message-rp", "Only numbers are valid for regular price.");
                         isValid = false;
                         } else {
                         clearError("error-message-rp");
                         }

                         // Sale Price Validation
                         if (salePrice.length === 0 || parseFloat(salePrice) < 0) {
                         showError("error-message-sp", "Field is required or the input is invalid.");
                         isValid = false;
                         } else if (!/^\d+$/.test(salePrice)) {
                         showError("error-message-sp", "Only numbers are valid for sale price.");
                         isValid = false;
                         } else {
                         clearError("error-message-sp");
                         }

                         // Description Validation
                         if (description.length === 0) {
                         showError("error-message-description", "Description is required.");
                         isValid = false;
                         } else if (description.length < 10 || description.length > 300) {
                         showError("error-message-description", "Description must be between 10 and 300 characters.");
                         isValid = false;
                         } else {
                         clearError("error-message-description");
                         }

                         // If the form is valid, submit or process data
                         if (!isValid) {
                              return
                         }
                         try {
                              const formdata={
                                   productName,
                                   categoryName,
                                   regularPrice,
                                   salePrice,
                                   description
                              }
                              const response = await fetch("/admin/product/addproduct",{
                                   method:"post",
                                   headers:{
                                             "content-Type":"application/json"
                                        },
                                        body:JSON.stringify(formdata)
                              })
                              if(response.ok){
                                   const result =await response.json()
                                   showSuccessNotification(result.message)

                              }
                              else{
                                   const errorResult =await response.json()
                                   showErrorNotification(errorResult.message)
                              }

                              
                         } catch (error) {
                              console.log(`error occur in fornent in the of adding product due to ${error}`)
                              showErrorNotification(error)
                         }
                         }

                         // Helper functions
                         function showError(id, message) {
                         const errorElement = document.getElementById(id);
                         if (errorElement) {
                         errorElement.textContent = message;
                         errorElement.style.color = "red";
                         }
                         }

                         function clearError(id) {
                         const errorElement = document.getElementById(id);
                         if (errorElement) {
                         errorElement.textContent = "";
                         }
                         }


                         function showSuccessNotification(message) {
            Swal.fire({
                title: 'Success',
                text: message||"sucessfully created",
                icon: 'success',
                position: 'top',
                toast: true,
                showConfirmButton: false,
                timer: 1500,
                timerProgressBar: true,
                showClass: {
                    popup: 'animate__animated animate__fadeInDown'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp'
                },
                background: '#fff',
                color: '#1a1a1a',
                iconColor: '#4CAF50',
                customClass: {
                    popup: 'premium-toast',
                    title: 'premium-title',
                    timerProgressBar: 'premium-progress'
                }
    }).then(() => {
        window.location.href = '/admin/product';
    });
}

// Error notification function
function showErrorNotification(message) {
    Swal.fire({
        title: 'Error',
        text: message || 'Verification failed',
        icon: 'error',
        position: 'top',
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        showClass: {
            popup: 'animate__animated animate__shakeX'
        },
        hideClass: {
            popup: 'animate__animated animate__fadeOutUp'
        },
        background: '#fff',
        color: '#1a1a1a',
        iconColor: '#FF3B30',
        customClass: {
            popup: 'premium-error-toast',
            title: 'premium-error-title',
