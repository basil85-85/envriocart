     <script>
document.addEventListener("DOMContentLoaded", async function () {
    await fetchAndRenderRevenueChart();
});

async function fetchAndRenderRevenueChart() {
    try {
        document.getElementById("error-message").style.display = "none";
        const response = await fetch('/admin/dashboard', {
            headers: { 'Accept': 'application/json' }
        });
        if (!response.ok) throw new Error("Failed to fetch sales data");

        const data = await response.json();
     //    console.log("Fetched Sales Data:", data);

        if (!data.salesData || typeof data.salesData !== "object") {
          //   console.warn("No valid sales data available.");
            return;
        }

        document.getElementById("total-orders").innerText = data.summary.totalOrders || 0;
        document.getElementById("total-revenue").innerText = "₹" + (data.summary.totalRevenue || 0).toLocaleString();
        document.getElementById("avg-order-value").innerText = "₹" + (data.summary.avgOrderValue || 0).toLocaleString();
        document.getElementById("pending-orders").innerText = data.summary.pendingOrders || 0;
         console.log(data.salesData)
        renderRevenueTrendChart(data.salesData);
    } catch (error) {
        console.error("Error fetching sales data:", error);
        document.getElementById("error-message").style.display = "block";
    }
}

function renderRevenueTrendChart(salesData) {
    console.log('Sales data for chart:', salesData);
    const dates = Object.keys(salesData);
    if (!dates.length) {
        console.warn("No sales data available for the chart.");
        return;
    }

    const revenues = dates.map(date => salesData[date]?.revenue || 0);
    const maxRevenue = revenues.length ? Math.max(...revenues) : 0;

    const canvas = document.getElementById("revenue-trend-chart");
    if (!canvas) {
        console.error("Canvas element not found!");
        return;
    }

    if (window.revenueChart) {
        window.revenueChart.destroy();
    }

    const ctx = canvas.getContext("2d");
    window.revenueChart = new Chart(ctx, {
        type: "bar",
        data: {
            labels: dates,
            datasets: [{
                label: "Revenue (₹)",
                data: revenues,
                borderColor: "#4F46E5",
                backgroundColor: "rgba(79, 70, 229, 0.7)",
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    type: "category",
                    title: { display: true, text: "Date" },
                    ticks: { autoSkip: false }
                },
                y: {
                    title: { display: true, text: "Revenue (₹)" },
                    beginAtZero: true,
                    suggestedMax: maxRevenue * 1.1 || 1000,
                    ticks: {
                        stepSize: Math.ceil(maxRevenue / 5) || 500,
                        callback: val => `₹${new Intl.NumberFormat('en-IN').format(val)}`
                    }
                }
            },
            plugins: {
                tooltip: {
                    callbacks: {
                        label: context => `₹${context.raw.toFixed(2)}`
                    }
                }
            }
        }
    });
}
 



async function FIlterBtb(Range) {
     try {
          const result = await Swal.fire({
               title: "Confirm Action",
               text: "Are you sure you want to proceed with this filter?",
               icon: "question",
               showCancelButton: true,
               confirmButtonColor: "#3085d6",
               cancelButtonColor: "#d33",
               confirmButtonText: "Yes, filter!",
               cancelButtonText: "Cancel"
          });
              if(result.isConfirmed){
                    const response = await fetch(`/admin/dashboard?range=${Range}`,{
                         headers: { 'Accept': 'application/json' }
                    })

                    if (!response.ok) throw new Error("Failed to fetch sales data");

                    const data = await response.json();
                    if (!data.salesData || typeof data.salesData !== "object") {
                    return;
                    }
                    document.getElementById("total-orders").innerText = data.summary.totalOrders || 0;
                    document.getElementById("total-revenue").innerText = "₹" + (data.summary.totalRevenue || 0).toLocaleString();
                    document.getElementById("avg-order-value").innerText = "₹" + (data.summary.avgOrderValue || 0).toLocaleString();
                    document.getElementById("pending-orders").innerText = data.summary.pendingOrders || 0;
                    console.log(data.salesData)
                    renderRevenueTrendChart(data.salesData);
             }

        
    } catch (error) {
        console.error("Error fetching sales data:", error);
        document.getElementById("error-message").style.display = "block";
    }
     
}
