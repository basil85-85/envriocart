      <script>
function updatingCategory(categoryId) {
    Swal.fire({
        title: "Are you sure?",
        text: "You will not be able to undo this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, update it!",
        cancelButtonText: "No, cancel!"
    }).then((result) => {
        if (result.isConfirmed) {
            fetch(`/admin/category/islisted/${categoryId}`, {
                method: 'PATCH',
                headers: {
                    "Content-Type": "application/json"
                }      
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    showSuccessNotification(data.message);
                   
                  
                } else {
                    showErrorNotification(data.message || 'Error updating category');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error updating category');
            });
        }
    });
}






function showSuccessNotification(message) {
            Swal.fire({
                title: 'Success',
                text: message,
                icon: 'success',
                position: 'top',
                toast: true,
                showConfirmButton: false,
                timer: 1500,
                timerProgressBar: true,
                showClass: {
                    popup: 'animate__animated animate__fadeInDown'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp'
                },
                background: '#fff',
                color: '#1a1a1a',
                iconColor: '#4CAF50',
                customClass: {
                    popup: 'premium-toast',
                    title: 'premium-title',
                    timerProgressBar: 'premium-progress'
                }
    })
    .then(()=>{
     location.reload();     
                    })
                    
}


// Error notification function
function showErrorNotification(message) {
    Swal.fire({
        title: 'Error',
        text: message || 'Verification failed',
        icon: 'error',
        position: 'top',
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        showClass: {
            popup: 'animate__animated animate__shakeX'
        },
        hideClass: {
            popup: 'animate__animated animate__fadeOutUp'
        },
        background: '#fff',
        color: '#1a1a1a',
        iconColor: '#FF3B30',
        customClass: {
            popup: 'premium-error-toast',
            title: 'premium-error-title',
            timerProgressBar: 'premium-error-progress'
        }
    });
}

</script>

