          <div class="page-content">

               <!-- Start Container Fluid -->
               <div class="container-xxl">
              <% if(products) { %>    
               <div class="row">
                    <!-- Left Side: Variants & Images -->
                    <div class="col-xl-3 col-lg-4">
                        <% if (products.variants && products.variants.length > 0) { %>
                            <% products.variants.forEach((val, index) => { %> 
                                <% if (val.productImg && val.productImg.length > 0) { %>
                                    <div class="mb-4">
                                        <h5 class="text-center">Variant <%= index + 1 %></h5>
                                        <div class="card mb-3" style="width: 100%; height: auto;">
                                             <div class="card-body d-flex flex-column align-items-center">
                                                 <img id="main-image-<%= index %>" 
                                                     src="/<%= val.productImg[0] %>" 
                                                     alt="Main Product Image" 
                                                     class="img-fluid rounded bg-light" 
                                                     style="width: 100%; max-height: 300px; object-fit: contain;">
                                             </div>
                                         </div>
                                         
                                         <!-- Small Thumbnails -->
                                         <div class="d-flex flex-wrap justify-content-center">
                                             <% val.productImg.forEach((img) => { %>  
                                                 <div class="card m-1" style="width: 55px; height: 55px; cursor: pointer;" 
                                                     onclick="changeImage('<%= index %>', '/<%= img %>')">
                                                     <div class="card-body d-flex align-items-center justify-content-center p-1">
                                                         <img src="/<%= img %>" 
                                                             alt="Product Image" 
                                                             class="img-fluid rounded bg-light" 
                                                             style="width: 100%; height: 100%; object-fit: cover;">
                                                     </div>
                                                 </div>
                                             <% }) %>
                                         
                                        </div>
                                    </div>
                                <% } else { %>
                                    <p class="text-muted">No images found for this variant.</p>
                                <% } %>
                            <% }) %>
                        <% } else { %>
                            <p class="text-muted">No variants available.</p>
                        <% } %>
                    </div>
                

                    <div class="col-xl-8 col-lg-11">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Product Information</h4>
                            </div>
                                   <div class="card-body">
                                        <div class="row">
                                            
                                                  <div class="d-flex align-items-center mb-3">
                                                       <label class="form-label me-2 mb-0">
                                                           <small class="text-muted fw-semibold">Product Name:</small>
                                                       </label>
                                                       <div class="fw-bold text-dark fs-5">
                                                         <%= products.productName %>
                                                       </div>
                                                   </div>
                                              
                                                   <div class="col-lg-6 mb-3 d-flex align-items-center">
                                                       <label for="product-categories" class="form-label mb-0 fw-semibold me-2">Product Categories:</label>
                                                       <div class="fw-bold text-dark fs-5">
                                                            <%= products.categoryName.name %>
                                                       </div>
                                                   </div>
                                                   
                                        </div>
                                          <% if (products.variants.length > 0) { %>
                                             <% products.variants.forEach((val,index)=>{ %>

                                                  <h5 class="text-center">Variant <%= index + 1 %></h5>
                                                  <a href="/admin/product/editVarient?id=<%=val._id%>" class="fancy-link">
                                                       Edit-varient
                                                       <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                         <path d="M5 12h14M12 5l7 7-7 7"/>
                                                       </svg>
                                                     </a>
                                             <div class="row mb-4">
                                                  <div class="col-lg-4">
                                                       <div class="mt-3">
                                              
                                                                 <h5 class="text-dark fw-medium">Size :</h5>
                                                                 <div class="d-flex flex-wrap gap-2" role="group" aria-label="Basic checkbox toggle button group">
                                                                      

                                                                      <% 
                                                                      let inStock = Object.values(val.size).some(quality => quality > 0); 
                                                                      if (inStock) { 
                                                                  %>
                                                                      <% for (let [size, quality] of Object.entries(val.size)) { %>
                                                                          <% if (quality > 0) { %>
                                                                              <h4 class="fw-bold text-primary"><%= size %></h4>
                                                                              <h4 class="text-success fw-medium">: <%= quality %></h4>
                                                                          <% } %>
                                                                      <% } %>
                                                                  <% } else { %>
                                                                      <p class="text-danger fw-bold fs-5">❌ OUT OF STOCK</p>
                                                                  <% } %>
                                                                  
                                                                 </div>
                                                           
                                                             
                                                             
                                                       </div>
                                                  </div>
                                                  <div class="col-lg-5">
                                                       <div class="mt-3">
              
                                                            <h5 class="text-dark fw-medium">Colors :</h5>
                                                            <div class="d-flex flex-wrap gap-2" role="group" aria-label="Basic checkbox toggle button group">
                                                                 <input type="color" id="colorPicker" name="color" class="color-circle" value="<%= val.productcolor %>">
                                                             </div>
                                                       </div>
                                                  </div>
                                             </div> 
                                             <% }) %>   
                                           <% } else { %>
                                             <h4 class="text-danger">there is no verients</h4>
                                             <% } %>
                                        <div class="row">
                                             <div class="col-lg-12">
                                                  <div class="mb-3">
                                                       <label for="description" class="form-label">Description</label>
                                                       <textarea class="form-control bg-light-subtle" id="description" rows="7" placeholder="<%=products.description %>"readonly><%=products.description %> </textarea>

                                                  </div>
                                             </div>
                                        </div>
      
                                   </div>
                              </div>
                              <div class="card">
                                   <div class="card-header">
                                        <h4 class="card-title">Pricing Details</h4>
                                   </div>
                                   <div class="card-body">
                                        <div class="row">
                                             <div class="col-lg-4">
                                                  
                                                       <label for="product-price" class="form-label">Seller Price</label>
                                                       <div class="input-group mb-3">
                                                            <span class="input-group-text fs-20"><i class='bx bx-rupee'></i>                                                            </span>
                                                            <input type="number" id="product-price" class="form-control" placeholder="<%=products.salePrice %>" value=""readonly>
                                                       </div>
                                           
                                             </div>
                                             <div class="col-lg-4">
                                                 
                                                  <label for="product-price" class="form-label">RegularPrice</label>
                                                  <div class="input-group mb-3">
                                                       <span class="input-group-text fs-20"><i class='bx bx-rupee'></i></span>
                                                       <input type="number" id="product-price" class="form-control" placeholder="<%=products.regularPrice %>" value=""readonly>
                                                  </div>       
                                               
                                             </div>
                                             
                                        </div>
                                   </div>
                                   <a href="/admin/product %>" class="btn btn-danger">Back</a>                                  
                              </div>
                              
                         </div>
                  <% } %>
                    </div>
                  

               </div>
