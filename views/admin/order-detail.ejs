<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Premium Order Details</title>
    <style>
        body {
            font-family: 'Playfair Display', 'Times New Roman', serif;
            margin: 0;
            padding: 20px;
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            min-height: 100vh;
            color: #333;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background-color: #fff;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        }
        .header {
            text-align: center;
            margin-bottom: 40px;
            padding-bottom: 30px;
            border-bottom: 2px solid #d4af37;
            position: relative;
        }
        .header:after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 50px;
            height: 3px;
            background: #d4af37;
        }
        .header h1 {
            font-size: 2.5em;
            color: #1a1a1a;
            margin: 0;
            font-weight: 700;
            letter-spacing: 2px;
        }
        .order-number {
            color: #d4af37;
            font-size: 1.2em;
            margin-top: 10px;
            font-style: italic;
        }
        .order-status {
            display: inline-block;
            padding: 12px 30px;
            background: linear-gradient(135deg, #3ad437 0%, #c3f26b 100%);
            color: #1a1a1a;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            border-radius: 30px;
            margin-top: 20px;
            font-size: 0.9em;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
        }
        .order-statusf {
            display: inline-block;
            padding: 12px 30px;
            background: linear-gradient(135deg, #d43737 0%, #f57200 100%);
            color: #1a1a1a;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            border-radius: 30px;
            margin-top: 20px;
            font-size: 0.9em;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
        }
        .order-details {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 40px;
            margin: 40px 0;
        }
        .detail-box {
            padding: 30px;
            background-color: #f9f9f9;
            border: 1px solid #e0e0e0;
            border-radius: 15px;
            position: relative;
            overflow: hidden;
        }
        .detail-box:before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(to bottom, #d4af37, #f2d06b);
        }
        .detail-box h3 {
            color: #1a1a1a;
            font-size: 1.4em;
            margin: 0 0 20px 0;
            font-weight: 600;
        }
        .products-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 20px;
            margin: 40px 0;
        }
        .products-table th {
            font-family: 'Playfair Display', serif;
            padding: 20px;
            text-align: left;
            color: #1a1a1a;
            font-size: 1.1em;
            font-weight: 600;
            border-bottom: 2px solid #d4af37;
        }
        .products-table td {
            padding: 25px 20px;
            background: #fff;
            border-top: 1px solid #e0e0e0;
            border-bottom: 1px solid #e0e0e0;
        }
        .products-table tr td:first-child {
            border-left: 1px solid #e0e0e0;
            border-top-left-radius: 15px;
            border-bottom-left-radius: 15px;
        }
        .products-table tr td:last-child {
            border-right: 1px solid #e0e0e0;
            border-top-right-radius: 15px;
            border-bottom-right-radius: 15px;
        }
        .product-info {
            display: flex;
            align-items: center;
            gap: 25px;
        }
        .product-image {
            width: 100px;
            height: 100px;
            border-radius: 10px;
            object-fit: cover;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .product-name {
            font-size: 1.1em;
            font-weight: 600;
            color: #1a1a1a;
            margin-bottom: 5px;
        }
        .product-details {
            color: #666;
            font-size: 0.9em;
            font-style: italic;
        }
        .total-section {
            background: #1a1a1a;
            color: #fff;
            padding: 30px;
            border-radius: 15px;
            margin-top: 40px;
        }
        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 15px 0;
            border-bottom: 1px solid rgba(212, 175, 55, 0.2);
        }
        .total-row:last-child {
            border-bottom: none;
            margin-top: 15px;
            padding-top: 15px;
            font-size: 1.4em;
            color: #d4af37;
        }
        .btn {
            padding: 15px 40px;
            border: none;
            border-radius: 30px;
            cursor: pointer;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s ease;
            font-size: 0.9em;
            margin: 10px;
        }
        .btn-primary {
            background: linear-gradient(135deg, #d4af37 0%, #f2d06b 100%);
            color: #1a1a1a;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
        }
        .btn-secondary {
            background: #1a1a1a;
            color: #d4af37;
            border: 2px solid #d4af37;
        }
        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
        }
        .tracking-info {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            color: #fff;
            padding: 30px;
            border-radius: 15px;
            margin: 40px 0;
            position: relative;
            overflow: hidden;
        }
        .tracking-info:before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, #d4af37 0%, transparent 70%);
            opacity: 0.1;
        }
        .back-button {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #f5f5f5;
    border: none;
    padding: 8px 12px;
    font-size: 16px;
    border-radius: 5px;
    cursor: pointer;
}
.back-button:hover {
    background: #e0e0e0;
}

    </style>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
    <div class="container">
        <button type="button" class="back-button" onclick="history.back()">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M8.354 1.646a.5.5 0 0 1 0 .708L2.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
            </svg>
            Back
        </button>
        <div class="header">
            <h1>Order Details</h1>
            <div class="order-number">Order #<%=order.orderId%></div>
            <% if(order.orderStatus!=="Cancelled") {%>
            <div class="order-status"><%=order.orderStatus%></div>
            <% }else { %>
                <div class="order-statusf"><%=order.orderStatus%></div>
                <% } %>
        </div>

        <!-- <div class="tracking-info">
            <h3 style="margin: 0 0 15px 0; color: #d4af37;">Delivery Status</h3>
            <p style="margin: 0; font-size: 1.1em;">Your premium package is being prepared with utmost care</p>
            <p style="margin: 5px 0 0 0; color: #d4af37; font-style: italic;">Expected Delivery: Feb 20, 2024</p>
        </div> -->

        <div class="order-details">
            <div class="detail-box">
                <h3>Shipping Address</h3>
                <p style="line-height: 1.8; margin: 0;">
                    <%=order.address.name%><br>
                    <%=order.address.address%><br>
                    <%=order.address.pincode%><br>
                    <%=order.address.phone%><br>

                </p>
            </div>

            <div class="detail-box">
                <h3>Order Information</h3>
                <p style="line-height: 1.8; margin: 0;">
                    <strong>Order Date:</strong><%= moment(order.createdAt).format("DD MMM YYYY hh:mm A") %><br>
                    <strong>Payment Method:</strong> <%=order. payment.method%><br>
                   
                </p>
            </div>
        </div>

        <table class="products-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <% if(order.cartItems.forEach((item)=>{ %>
                <tr>
                    <td>
                        <div class="product-info">
                            <img src="<%=item.image%>" alt="Luxury T-Shirt" class="product-image">
                            <div>
                                <div class="product-name"><%=item.name%></div>
                                <div class="product-details">Size: <%=item.size %>| Color: 
                                    <button 
                                        type="button"
                                        class="color-selector circle"
                                        style="background-color: <%= item.color %>; border: 2px solid #ddd; width: 20x; height: 20px; border-radius: 50%; display: inline-block;"
                                    >
                                    </button>
                            </div>
                        </div>
                    </td>
                    <td><%=item.quantity%></td>
                    <td><%=item.price%></td>
                    <td><%=item.total%></td>
                </tr>
                <%  })) %>
               
            </tbody>
        </table>

        <div class="total-section">
            <div class="total-row">
                <span>Subtotal</span>
                <span>Rs:<%=order.totalAmount%></span>
            </div>
            <div class="total-row">
                <span>discount</span>
                <span><%=order.discount%></span>
            </div>
            <div class="total-row">
                <span>deliveryCharge</span>
                <span><%=order.discount%></span>
            </div>
            <div class="total-row">
                <span>Grand Total </span>
                <span>Rs:<%=order.grandTotal%> </span>
            </div>
        </div>

        <div style="text-align: center; margin-top: 50px;">
            <button class="btn btn-primary">Track Your Package</button>
            <button class="btn btn-secondary">Download Invoice</button>
        </div>
    </div>
</body>
</html>