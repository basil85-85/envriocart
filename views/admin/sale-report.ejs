                <script>
          async function applyFilter() {
    try {
        // Get filter values
        const filter = document.getElementById("filterType").value;
        const startDate = document.getElementById("startDate").value;
        const endDate = document.getElementById("endDate").value;

        // Validate dates for custom filter
        if (filter === 'custom' && (!startDate || !endDate || startDate > endDate)) {
            showErrorNotification('Please select valid date range');
            return;
        }

        // Send request
        const response = await fetch("/admin/sale-report/filter", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ filter, startDate, endDate })
        });

        // Check if response is HTML
        const contentType = response.headers.get("content-type");
        if (contentType && contentType.includes("text/html")) {
            // If HTML response, replace the current page content
            document.documentElement.innerHTML = await response.text();
        } else {
            // If JSON response, handle success/error
            const data = await response.json();
            if (data.success) {
                showSuccessNotification(data.message);
            } else {
                showErrorNotification(data.message);
            }
        }
    } catch (error) {
        showErrorNotification("An error occurred while filtering");
    }
}



                    function showSuccessNotification(message) {
            Swal.fire({
                title: 'Success',
                text: message||"sucessfully created",
                icon: 'success',
                position: 'top',
                toast: true,
                showConfirmButton: false,
                timer: 1500,
                timerProgressBar: true,
                showClass: {
                    popup: 'animate__animated animate__fadeInDown'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp'
                },
                background: '#fff',
                color: '#1a1a1a',
                iconColor: '#4CAF50',
                customClass: {
                    popup: 'premium-toast',
                    title: 'premium-title',
                    timerProgressBar: 'premium-progress'
                }
    }).then(() => {
        window.location.href = '/admin/sale-Report';
    });
}

// Error notification function
function showErrorNotification(message) {
    Swal.fire({
        title: 'Error',
        text: message || 'Verification failed',
        icon: 'error',
        position: 'top',
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        showClass: {
            popup: 'animate__animated animate__shakeX'
        },
        hideClass: {
            popup: 'animate__animated animate__fadeOutUp'
        },
        background: '#fff',
        color: '#1a1a1a',
        iconColor: '#FF3B30',
        customClass: {
            popup: 'premium-error-toast',
            title: 'premium-error-title',
            timerProgressBar: 'premium-error-progress'
        }
    });
} 
                </script>
