                                                            <a href="?page=<%= currentPage - 1 %>&filter=<%= filter %><%= startDate ? `&startDate=${startDate}` : '' %><%= endDate ? `&endDate=${endDate}` : '' %>" 
                                                               class="page-link" 
                                                               <%= currentPage === 1 ? 'tabindex="-1" aria-disabled="true"' : '' %>>
                                                                <i class="bx bx-left-arrow-alt"></i>
                                                            </a>
                                                        </li>
                                    
                                                        <% 
                                                        let startPage = Math.max(1, currentPage - 1);
                                                        let endPage = Math.min(totalPages, startPage + 2);
                                                        if (endPage - startPage < 2) {
                                                            startPage = Math.max(1, endPage - 2);
                                                        }
                                                        %>
                                    
                                                        <% for(let i = startPage; i <= endPage; i++) { %>
                                                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                                <a href="?page=<%= i %>&filter=<%= filter %><%= startDate ? `&startDate=${startDate}` : '' %><%= endDate ? `&endDate=${endDate}` : '' %>" 
                                                                   class="page-link">
                                                                    <%= i %>
                                                                </a>
                                                            </li>
                                                        <% } %>
                                    
                                                        <!-- Next page -->
                                                        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                            <a href="?page=<%= currentPage + 1 %>&filter=<%= filter %><%= startDate ? `&startDate=${startDate}` : '' %><%= endDate ? `&endDate=${endDate}` : '' %>" 
                                                               class="page-link"
                                                               <%= currentPage === totalPages ? 'tabindex="-1" aria-disabled="true"' : '' %>>
                                                                <i class="bx bx-right-arrow-alt"></i>
                                                            </a>
                                                        </li>
                                                    </ul>
                                                <% } %>
