    const cropButton = document.getElementById(`cropButton${index}`);
    const croppedResult = document.getElementById(`croppedResult${index}`);
    const uploadStatus = document.getElementById(`uploadStatus${index}`);
    let cropper = null;

    // Prevent default drag behaviors
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, preventDefaults, false);
        document.body.addEventListener(eventName, preventDefaults, false);
    });

    // Highlight drop zone when item is dragged over it
    ['dragenter', 'dragover'].forEach(eventName => {
        dropArea.addEventListener(eventName, () => {
            dropArea.classList.add('dragover');
        }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, () => {
            dropArea.classList.remove('dragover');
        }, false);
    });

    // Handle dropped files
    dropArea.addEventListener('drop', handleDrop, false);
    dropArea.addEventListener('click', () => inputFile.click());
    inputFile.addEventListener('change', handleFiles, false);

    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }

    function handleDrop(e) {
        const dt = e.dataTransfer;
        const files = dt.files;
        handleFiles({ target: { files: files } });
    }

    function handleFiles(e) {
        const file = e.target.files[0];
        errorMessage.textContent = '';
        
        if (file) {
            // Validate file type
            if (!file.type.startsWith('image/')) {
                errorMessage.textContent = 'Please select an image file.';
                return;
            }

            // Validate file size (max 5MB)
            if (file.size > 5 * 1024 * 1024) {
                errorMessage.textContent = 'Image size should be less than 5MB.';
                return;
            }

            const reader = new FileReader();
            reader.onload = function(event) {
                // Destroy existing cropper if it exists
                if (cropper) {
                    cropper.destroy();
                }

                // Show preview container and set image source
                previewContainer.style.display = 'block';
                imagePreview.src = event.target.result;

                // Initialize cropper after image is loaded
                imagePreview.onload = function() {
                    cropper = new Cropper(imagePreview, {
                        aspectRatio: 6 / 9,
                        viewMode: 1,
                        autoCropArea: 0.8,
                        responsive: true,
                        guides: true,
                        center: true,
                        cropBoxMovable: true,
                        cropBoxResizable: true,
                        ready: function() {
                            // Ensure the cropper is visible
                            this.cropper.containerData.width = previewContainer.offsetWidth;
                            this.cropper.containerData.height = previewContainer.offsetWidth * (5/10);
                        }
                    });
                };
            };
            reader.readAsDataURL(file);
        }
    }

    cropButton.addEventListener('click', function(e) {
        e.preventDefault();
        if (!cropper) return;

        const spinner = document.getElementById(`spinner${index}`);
        spinner.classList.add('active');

        setTimeout(() => {
            const croppedCanvas = cropper.getCroppedCanvas({
                width:300,
                height:400,
                imageSmoothingEnabled: true,
                imageSmoothingQuality: 'high'
            });

            const croppedImage = croppedCanvas.toDataURL('image/jpeg', 0.9);
            croppedResult.src = croppedImage;
            croppedResult.style.display = 'block';
            spinner.classList.remove('active');
            uploadStatus.textContent = 'Image cropped and saved successfully!';
        }, 1000);
    });
}

