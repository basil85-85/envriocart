<%- include('../partial/user/header') %>
<style>
    body {
        margin: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #f8fafc, #e2e8f0);
        font-family: 'Arial', sans-serif;
    }

    .success-container {
        text-align: center;
        padding: 40px;
        max-width: 800px;
        margin: 40px auto;
    }

    .checkmark-wrapper {
        position: relative;
        width: 120px;
        height: 120px;
        margin: 0 auto;
    }

    .star {
        position: absolute;
        fill: #3b82f6;
        opacity: 0;
        width: 19px;
        height: 19px;
    }

    .star:nth-child(1) { top: -10%; left: 20%; animation-delay: 0.2s; }
    .star:nth-child(2) { top: 20%; right: -10%; animation-delay: 0.4s; }
    .star:nth-child(3) { top: 40%; left: -10%; animation-delay: 0.6s; }
    .star:nth-child(4) { top: 60%; right: -10%; animation-delay: 0.8s; }
    .star:nth-child(5) { top: 80%; left: -5%; animation-delay: 1s; }
    .star:nth-child(6) { top: 90%; right: 0%; animation-delay: 1.2s; }

    .star {
        animation: starRotate 2s ease-in-out infinite;
    }

    @keyframes starRotate {
        0% { transform: scale(0) rotate(0deg); opacity: 0; }
        50% { transform: scale(1.2) rotate(180deg); opacity: 1; }
        100% { transform: scale(0) rotate(360deg); opacity: 0; }
    }

    .checkmark__check {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        animation: checkmark 1s cubic-bezier(0.65, 0, 0.45, 1) forwards;
        fill: #22c55e;
        z-index: 2;
    }

    @keyframes checkmark {
        0% { transform: translate(-50%, -50%) scale(0); }
        50% { transform: translate(-50%, -50%) scale(1.2); }
        100% { transform: translate(-50%, -50%) scale(1); }
    }

    .checkmark__background {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0);
        animation: background 1s cubic-bezier(0.65, 0, 0.45, 1) forwards;
        fill: #bbf7d0;
        z-index: 1;
    }

    @keyframes background {
        from { transform: translate(-50%, -50%) scale(0); }
        to { transform: translate(-50%, -50%) scale(1); }
    }

    .success-text {
        text-align: center;
        margin-top: 30px;
        animation: fadeUp 0.8s ease-out forwards;
        opacity: 0;
    }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    h2 {
        color: #0f172a;
        font-size: 2.5em;
        margin: 20px 0;
    }

    p {
        color: #475569;
        font-size: 1.2em;
        margin: 10px 0;
    }

    .transaction-id {
        font-family: monospace;
        color: #3b82f6;
        font-size: 1.1em;
        background: rgba(59, 130, 246, 0.1);
        padding: 10px 20px;
        border-radius: 8px;
        display: inline-block;
        margin: 20px 0;
    }

    button {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 1.1em;
        cursor: pointer;
        transition: background 0.3s;
    }

    button:hover {
        background: #2563eb;
    }
   

  


    h2 {
        color: #0f172a;
        font-size: 2.5em;
        text-transform: capitalize;
        margin: 20px 0;
    }

    p {
        color: #475569;
        font-size: 1.2em;
        margin: 10px 0;
    }

    .transaction-id {
        font-family: monospace;
        color: #3b82f6;
        font-size: 1.1em;
        background: rgba(59, 130, 246, 0.1);
        padding: 10px 20px;
        border-radius: 8px;
        display: inline-block;
        margin: 20px 0;
    }

    .confetti {
        position: fixed;
        width: 10px;
        height: 10px;
        animation: confetti 3s ease-in-out infinite;
    }

    @keyframes confetti {
        0% { transform: translateY(-100vh) rotate(0deg); }
        100% { transform: translateY(100vh) rotate(360deg); }
    }
</style>

<script>
    function createConfetti() {
        const colors = ['#3b82f6', '#22c55e', '#eab308', '#ef4444'];
        for (let i = 0; i < 50; i++) {
            const confetti = document.createElement('div');
            confetti.className = 'confetti';
            confetti.style.left = Math.random() * 100 + 'vw';
            confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
            confetti.style.animationDelay = Math.random() * 3 + 's';
            document.body.appendChild(confetti);
        }
    }
    createConfetti();
</script>

                        
