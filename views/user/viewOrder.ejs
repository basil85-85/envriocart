async function initiateRepayment(orderID,userID) {
    try {
        const confirm = await Swal.fire({
            title: "Repay Amount?",
            text: "Do you want to proceed with the repayment for this order?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#28a745",  
            cancelButtonColor: "#d33", 
            confirmButtonText: "Yes, Repay",
            cancelButtonText: "No, Cancel"
        });
        if(confirm.isConfirmed){
            const orderResponse = await fetch(`/repayment-razerPay?id=${orderID}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
        })
        const orderData = await orderResponse.json();

            if (!orderData.success) {
                throw new Error(orderData.message);
            }

            const options = {
                key: 'rzp_test_Bj3nLhzRxxOUEo', 
                amount: orderData.amount,
                currency: "INR",
                name: "ENVRIO CART",
                description: "Order Payment",
                order_id: orderData.orderId,
                handler: async function (response) {
                    const verifyResponse = await fetch(`/VerifyRepayment?id=${userID}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            razorpay_payment_id: response.razorpay_payment_id,
                            razorpay_order_id: response.razorpay_order_id,
                            razorpay_signature: response.razorpay_signature,
                           
                        })
                    });
                    const verifyData = await verifyResponse.json();

                    if (verifyData.success) {
                        showSuccessNotification("Payment successful!");
                        setTimeout(()=>{

                            location.reload()
                        } ,1500)
                       
                    } else {
                        showErrorNotification("Payment verification failed!");
                    }
                },
                
                theme: {
                    color: "#ff6600", 
                    backdrop_color: "#f0f0f0", 
                    hide_topbar: false 
                }
}

            const rzp = new Razorpay(options);
            rzp.open();

       
        }
    } catch (error) {
        showErrorNotification(error)
    }
}

