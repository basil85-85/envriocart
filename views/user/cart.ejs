    <script>
        function openSearch() {
            document.getElementById("search-overlay").style.display = "block";
        }

        function closeSearch() {
            document.getElementById("search-overlay").style.display = "none";
        }
        function DeleteCart(itemId) {
                fetch(`/deleteCart?id=${itemId}`, {
                    method: "DELETE",
                })
                .then(response => response.json())  // Parse the JSON response
                .then(data => {
                    if (data.success) {
                        showSuccessNotification(data.message);
                        location.reload();  // Reload the page to update the cart
                    } else {
                        showErrorNotification(data.message);
                    }
                })
                .catch(error => {
                    console.error("Error deleting cart item:", error);
                    showErrorNotification("An error occurred while deleting the item");
                });
            }




function showSuccessNotification(message) {
            Swal.fire({
                title: 'Success',
                text: message,
                icon: 'success',
                position: 'top',
                toast: true,
                showConfirmButton: false,
                timer: 1500,
                timerProgressBar: true,
                showClass: {
                    popup: 'animate__animated animate__fadeInDown'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp'
                },
                background: '#fff',
                color: '#1a1a1a',
                iconColor: '#4CAF50',
                customClass: {
                    popup: 'premium-toast',
                    title: 'premium-title',
                    timerProgressBar: 'premium-progress'
                }
    })
}


function showErrorNotification(message) {

    Swal.fire({
        title: 'Error',
        text: message || 'Verification failed',
        icon: 'error',
        position: 'top',
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        showClass: {
            popup: 'animate__animated animate__shakeX'
        },
        hideClass: {
            popup: 'animate__animated animate__fadeOutUp'
        },
        background: '#fff',
        color: '#1a1a1a',
        iconColor: '#FF3B30',
        customClass: {
            popup: 'premium-error-toast',
            title: 'premium-error-title',
            timerProgressBar: 'premium-error-progress'
        }
    });
}




const QUANTITY_LIMITS = {
    MIN: 1,
    MAX: 5
};

// Frontend: Cart Update Handler
async function handleQuantityUpdate(productId, change, size) {
    const elements = {
        quantity: document.getElementById(`quantity-${productId}`),
        increase: document.getElementById(`increase-${productId}`),
        decrease: document.getElementById(`decrease-${productId}`),
        price: document.getElementById(`priceItems-${productId}`),
        totalPrice: document.getElementById(`totalPrice-${productId}`),
        subTotal: document.getElementById(`subTotal-${productId}`),
        grandTotal: document.getElementById('grandTotal')
    };

    // Validate elements exist
    if (!Object.values(elements).every(element => element)) {
        console.error('Required DOM elements not found');
        return showAlert('error', 'System error. Please refresh the page.');
    }

    const currentQuantity = parseInt(elements.quantity.value);
    const newQuantity = currentQuantity + change;

    // Validate quantity limits
    if (newQuantity < QUANTITY_LIMITS.MIN || newQuantity > QUANTITY_LIMITS.MAX) {
        return showAlert('info', `Quantity must be between ${QUANTITY_LIMITS.MIN} to ${QUANTITY_LIMITS.MAX}`);
    }

    try {
        const response = await fetch('/updateCartQuantity', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId, quantity: newQuantity, size })
        });

        const data = await response.json();

        if (response.ok && data.status) {
            updateCartDisplay(elements, newQuantity, data.availableStock, data.newTotal);
        } else {
            showAlert('warning', data.message);
            if (data.availableStock) {
                updateCartDisplay(elements, data.availableStock, data.availableStock, data.newTotal);
            }
        }
    } catch (error) {
        console.error('Error updating quantity:', error);
        showAlert('error', 'Failed to update quantity. Please try again.');
    }
}

// Frontend: Helper Functions
function updateCartDisplay(elements, quantity, availableStock, newTotal) {
    const price = parseFloat(elements.price.innerText.replace('₹', ''));
    const total = price * quantity;

    elements.quantity.value = quantity;
    elements.totalPrice.innerText = `₹${total}`;
    elements.subTotal.innerText = `₹${total}`;
    elements.grandTotal.innerText = `₹${newTotal}`;

    updateButtonStates(elements, quantity, availableStock);
}

function updateButtonStates(elements, quantity, availableStock) {
    elements.decrease.disabled = quantity <= QUANTITY_LIMITS.MIN;
    elements.increase.disabled = quantity >= Math.min(availableStock, QUANTITY_LIMITS.MAX);
}

function showAlert(icon, title) {
    return Swal.fire({
        icon,
        title,
        showConfirmButton: false,
        timer: 2000
    });
}

    </script>
