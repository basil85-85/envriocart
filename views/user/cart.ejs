    <script>
        function openSearch() {
            document.getElementById("search-overlay").style.display = "block";
        }

        function closeSearch() {
            document.getElementById("search-overlay").style.display = "none";
        }
        function DeleteCart(itemId) {
                fetch(`/deleteCart?id=${itemId}`, {
                    method: "DELETE",
                })
                .then(response => response.json())  // Parse the JSON response
                .then(data => {
                    if (data.success) {
                        showSuccessNotification(data.message);
                        location.reload();  // Reload the page to update the cart
                    } else {
                        showErrorNotification(data.message);
                    }
                })
                .catch(error => {
                    console.error("Error deleting cart item:", error);
                    showErrorNotification("An error occurred while deleting the item");
                });
            }




function showSuccessNotification(message) {
            Swal.fire({
                title: 'Success',
                text: message,
                icon: 'success',
                position: 'top',
                toast: true,
                showConfirmButton: false,
                timer: 1500,
                timerProgressBar: true,
                showClass: {
                    popup: 'animate__animated animate__fadeInDown'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp'
                },
                background: '#fff',
                color: '#1a1a1a',
                iconColor: '#4CAF50',
                customClass: {
                    popup: 'premium-toast',
                    title: 'premium-title',
                    timerProgressBar: 'premium-progress'
                }
    })
}


function showErrorNotification(message) {

    Swal.fire({
        title: 'Error',
        text: message || 'Verification failed',
        icon: 'error',
        position: 'top',
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        showClass: {
            popup: 'animate__animated animate__shakeX'
        },
        hideClass: {
            popup: 'animate__animated animate__fadeOutUp'
        },
        background: '#fff',
        color: '#1a1a1a',
        iconColor: '#FF3B30',
        customClass: {
            popup: 'premium-error-toast',
            title: 'premium-error-title',
            timerProgressBar: 'premium-error-progress'
        }
    });
}


const QUANTITY_LIMITS = {
    MIN: 1,
    MAX: 5
};

document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".increase, .decrease").forEach(button => {
        button.addEventListener("click", async function () {
            const productId = this.getAttribute("data-product-id");
            const size = this.getAttribute("data-size");
            const change = this.classList.contains("increase") ? 1 :-1 ;
            await handleQuantityUpdate(productId, change, size);

        });
    });
});

async function handleQuantityUpdate(productId, change, size) {
    const quantityElement = document.getElementById(`quantity-${productId}-${size}`);
    const subTotalElement = document.getElementById(`SubTotal-${productId}-${size}`)
    const total = document.getElementById("totalPrice")
    console.log(total)
    let currentQuantity = parseInt(quantityElement.value);
    let newQuantity = currentQuantity + change;


    if (newQuantity < 1 || newQuantity > 5) {
        return Swal.fire({
            icon: 'info',
            title: 'Quantity must be between 1 to 5',
            showConfirmButton: false,
            timer: 2000
        });
    }

    try {
        const response = await fetch('/updateCartQuantity', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId, quantity: newQuantity, size })
        });

        const data = await response.json();

        if (response.ok) { 
            quantityElement.value = data.quantity
            total.innerText = `Rs: ${data.newTotal}`
             subTotalElement.innerText = `Rs : ${data.subtotal}`
           
        } else {
            showErrorNotification(data.message)
        }
    } catch (error) {
        console.error('Error updating quantity:', error);
        Swal.fire({
            icon: 'error',
            title: 'Failed to update quantity. Please try again.',
            showConfirmButton: false,
            timer: 2000
        });
    }
}




    </script>
