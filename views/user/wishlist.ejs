    <script>
        function openSearch() {
            document.getElementById("search-overlay").style.display = "block";
        }

        function closeSearch() {
            document.getElementById("search-overlay").style.display = "none";
        }


       async function deleteWishlit(wishlistID,productID){
                try{
                       const result = await Swal.fire({
                              title: "Are you sure?",
                              text: "Do you needed to delect it",
                              icon: "warning",
                              showCancelButton: true,
                              confirmButtonColor: "#3085d6",
                              cancelButtonColor: "#d33",
                              confirmButtonText: "Yes, proceed!"
                         });

                         if (result.isConfirmed) {
                              const response = await fetch(`/deleteWishlist?wishlistId=${wishlistID}&productId=${productID}`,{
                                   method: "delete", 
                                   headers: { "Content-Type": "application/json" }
                              });
                              const data= await response.json()
                              if(data.success){
                                showSuccessNotification(data.message)
                                setTimeout(()=>{
                                    location.reload()
                                },1500)
                              }
                              else{
                                showErrorNotification(data.message)
                              }
                         }
          }
          catch(error){
               showErrorNotification(error)
          }
        }



        async function addToCart(variantId, productName, price, size, color, image) {
    try {
        if (!size) {  // Check if size is null, undefined, or empty
            showErrorNotification("OUT OF STOCK");
            return;
        }

        const cartItem = { variantId, productName, price, size, color, image , quantity: 1};

        const response = await fetch("/addCart", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(cartItem),
        });

        const data = await response.json();

        if (response.ok && data.success) {
            showSuccessNotification(data.message);
        } else {
            showErrorNotification(data.message || "Unable to add item to cart!");
        }
    } catch (error) {
        console.error("Error adding to cart:", error);
        showErrorNotification("Network issue! Please try again.");
    }
}


        

    function showSuccessNotification(message) {
            Swal.fire({
                title: 'Success',
                text: message,
                icon: 'success',
                position: 'top',
                toast: true,
                showConfirmButton: false,
                timer: 1500,
                timerProgressBar: true,
                showClass: {
                    popup: 'animate__animated animate__fadeInDown'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp'
                },
                background: '#fff',
                color: '#1a1a1a',
                iconColor: '#4CAF50',
                customClass: {
                    popup: 'premium-toast',
                    title: 'premium-title',
                    timerProgressBar: 'premium-progress'
                }
    })
}

// Error notification function
   function showErrorNotification(message) {

    Swal.fire({
        title: 'Error',
        text: message || 'Verification failed',
        icon: 'error',
        position: 'top',
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        showClass: {
            popup: 'animate__animated animate__shakeX'
        },
        hideClass: {
            popup: 'animate__animated animate__fadeOutUp'
        },
        background: '#fff',
        color: '#1a1a1a',
        iconColor: '#FF3B30',
        customClass: {
            popup: 'premium-error-toast',
            title: 'premium-error-title',
            timerProgressBar: 'premium-error-progress'
        }
    });
}
    </script>
