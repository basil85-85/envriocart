                    <tbody>
                        <% wishlist.products.forEach((item)=>{ %>
                        <tr>
                            <td>
                              

                                
                                <a href="/details?id=<%= item.verientId.productId %>">
                                    <img src="<%=item.image%>" alt="">
                                </a>
                              
                            </td>
                            <td><a href="product-page(accordian).html"><%=item.productName%></a>
                                <div class="mobile-cart-content row">
                                    <div class="col">
                                        <% if(item.size===null) {%>
                                        <p>OUT OF STOCK</p>
                                        <% }else{ %>
                                            <p>IN STOCK</p>
                                        <% } %>
                                    </div>
                                    <div class="col">
                                        <h2 class="td-color">$9.96</h2>
                                    </div>
                                    <div class="col">
                                        <h2 class="td-color">
                                            <a href="#!" class="icon me-1">
                                                <i class="ri-close-line"></i>
                                            </a>
                                            <a href="#!" class="cart">
                                                <i class="ri-shopping-cart-line"></i>
                                            </a>
                                        </h2>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <button style="background-color: <%= item.color %>; width: 30px; height: 30px; border-radius: 50%; border: none;"></button>

                            </td>
                            <td>
                                <h2><%=item.price%></h2>
                            </td>
                            <td>
                                <% if(item.size === null) { %>
                                    <p class="stock-status out-of-stock">OUT OF STOCK</p>
                                <% } else { %>
                                    <p class="stock-status in-stock"><%=item.size%></p>
                                <% } %>
                                
                            </td>
                            <td>
                                <div class="icon-box">
                                    <div class="button-container">
                                        <button type="button" onclick="deleteWishlit('<%=wishlist._id%>','<%=item._id%>')" class="icon-button">
                                            <i class="ri-close-line"></i>
                                        </button>
                                        <button type="button" onclick="addToCart('<%= item.verientId._id %>', '<%= item.productName %>', '<%= item.price %>', '<%= item.size %>', '<%= item.color %>', '<%= item.image %>')" class="cart-button">
                                            <i class="ri-shopping-cart-line"></i>
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <%}) %>
                       
                    </tbody>
                </table>
            </div>
            <div class="wishlist-buttons">
                <a href="/shop" class="btn btn-solid">continue shopping</a>
             
            </div>
        </div>
    </section>
    <% }else { %> 
