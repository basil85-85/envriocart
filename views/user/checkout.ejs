// Function to validate fields with animation
function validateField(id, value, errorId, errorMessage, regexOrFunc = v => v.trim() !== "") {
    const field = document.getElementById(id);
    const isValid = typeof regexOrFunc === "function" ? regexOrFunc(value) : regexOrFunc.test(value);
    
    if (!isValid) {
        showError(errorId, errorMessage);
        field.classList.add('field-animation', 'field-error', 'input-shake');
        field.addEventListener('animationend', () => {
            field.classList.remove('input-shake');
        });
        return false;
    } else {
        clearError(errorId);
        field.classList.remove('field-error');
        field.classList.add('field-animation', 'field-success');
        return true;
    }
}

function populateEditForm(addressData) {
    let add = JSON.parse(addressData); 

    document.getElementById("title2").value = add.title || "";
    document.getElementById("name6").value = add.address || "";
    document.getElementById("city2").value = add.city || "";
    document.getElementById("pincode2").value = add.pincode || "";
    document.getElementById("name5").value = add.phone || "";

    document.getElementById("addressId").value = add._id || "";

    let stateDropdown = document.getElementById("input-state-ope").value=add.state ||"";
    for (let i = 0; i < stateDropdown.options.length; i++) {
        if (stateDropdown.options[i].text === add.state) {
            stateDropdown.options[i].selected = true;
            break;
        }
    }
}

function editAddress(event) {
    event.preventDefault();
    let isValid = true;

    // Get form values
    let title = document.getElementById("title2").value.trim();
    let address = document.getElementById("name6").value.trim();
    let phone = document.getElementById("name5").value.trim();
    let country = document.getElementById("input-state-06").value;
    let state = document.getElementById("input-state-ope").value;
    let city = document.getElementById("city2").value.trim();
    let pincode = document.getElementById("pincode2").value.trim();
    let addressId = document.getElementById("addressId").value;

    // Validate each field with animations
    isValid = validateField("title2", title, "error-title", "Title is required") && isValid;
    
    isValid = validateField("name6", address, "error-address1", "Address is required") && isValid;
    
    isValid = validateField(
        "name5", 
        phone, 
        "error-phone1", 
        "Enter a valid phone number (e.g. +91 9876543210)", 
        value => /^\d{10}$/.test(value)
    ) && isValid;
    
    isValid = validateField(
        "input-state-06", 
        country, 
        "error-country1", 
        "Please select a country", 
        value => value !== "Select Country"
    ) && isValid;
    
    isValid = validateField(
        "input-state-ope", 
        state, 
        "error-state1", 
        "Please select a state", 
        value => value !== "Select State"
    ) && isValid;
    
    isValid = validateField("city2", city, "error-city1", "City is required") && isValid;
    
    isValid = validateField(
        "pincode2", 
        pincode, 
        "error-pincode1", 
        "Enter a valid Pin Code", 
        value => /^\d{4,6}$/.test(value)
    ) && isValid;

    if (isValid) {
        const formData = {
            title,
            address,
            phone,
            country,
            state,
            city,
            pincode,
            addressId
        };

        const submitButton = event.target;
        submitButton.disabled = true;
        submitButton.innerHTML = `
            <span class="spinner-border spinner-border-sm mr-2"></span>
            <span>Updating...</span>
        `;

        fetch(`/editAddress?id=${addressId}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(formData)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showSuccessNotification("Address updated successfully!");
                // Add success animation to form
                const form = document.querySelector('#edit-address .modal-content');
                form.style.transition = 'transform 0.3s ease-out';
                form.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    location.reload();
                }, 1500);
            } else {
                showErrorNotification(data.message || "Failed to update address");
            }
        })
        .catch(error => {
            console.error("Error:", error);
            showErrorNotification("Something went wrong. Please try again later.");
        })
        .finally(() => {
            submitButton.disabled = false;
            submitButton.innerHTML = 'Submit';
        });
    }
}



