        async function addAddress(event, userId) {
    event.preventDefault();

    let isValid = true;
    const errorIcons = {
        error: "❌",
        warning: "⚠️",
        success: "✅"
    };

    // Validation Rules Object
    const validationRules = {
        title: {
            element: document.getElementById("title"),
            getValue: (el) => el ? el.options[el.selectedIndex].text.trim() : "",
            validate: (value) => {
                if (!value || value.toLowerCase() === "select") {
                    return { isValid: false, message: `${errorIcons.error} Please select a valid title` };
                }
                return { isValid: true };
            }
        },
        address: {
            element: document.getElementById("address"),
            getValue: (el) => el?.value.trim() || "",
            validate: (value) => {
                if (!value) {
                    return { isValid: false, message: `${errorIcons.error} Address is required` };
                }
                if (value.length < 5) {
                    return { isValid: false, message: `${errorIcons.warning} Address must be at least 5 characters` };
                }
                if (!/^[a-zA-Z0-9\s,.-]+$/.test(value)) {
                    return { isValid: false, message: `${errorIcons.error} Address contains invalid characters` };
                }
                if (value.length > 200) {
                    return { isValid: false, message: `${errorIcons.warning} Address should not exceed 200 characters` };
                }
                return { isValid: true };
            }
        },
        phone: {
            element: document.getElementById("phone"),
            getValue: (el) => el?.value.trim() || "",
            validate: (value) => {
                if (!value) {
                    return { isValid: false, message: `${errorIcons.error} Phone number is required` };
                }
                if (!/^[6-9]\d{9}$/.test(value)) {
                    return { isValid: false, message: `${errorIcons.error} Enter a valid Indian mobile number` };
                }
                return { isValid: true };
            }
        },
        country: {
            element: document.getElementById("country"),
            getValue: (el) => el ? el.options[el.selectedIndex].text.trim() : "",
            validate: (value) => {
                if (!value || value.toLowerCase() === "select") {
                    return { isValid: false, message: `${errorIcons.error} Please select a country` };
                }
                return { isValid: true };
            }
        },
        pincode: {
            element: document.getElementById("pincode"),
            getValue: (el) => el?.value.trim() || "",
            validate: (value) => {
                if (!value) {
                    return { isValid: false, message: `${errorIcons.error} PIN code is required` };
                }
                if (!/^[1-9][0-9]{5}$/.test(value)) {
                    return { isValid: false, message: `${errorIcons.error} Enter a valid 6-digit PIN code` };
                }
                return { isValid: true };
            }
        },
        state: {
            element: document.getElementById("state"),
            getValue: (el) => el ? el.options[el.selectedIndex].text.trim() : "",
            validate: (value) => {
                if (!value || value.toLowerCase() === "select state") {
                    return { isValid: false, message: `${errorIcons.error} Please select a state` };
                }
                return { isValid: true };
            }
        },
        city: {
            element: document.getElementById("city"),
            getValue: (el) => el?.value.trim() || "",
            validate: (value) => {
                if (!value) {
                    return { isValid: false, message: `${errorIcons.error} City is required` };
                }
                if (value.length < 3) {
                    return { isValid: false, message: `${errorIcons.warning} City name must be at least 3 characters` };
                }
                if (!/^[a-zA-Z\s]+$/.test(value)) {
                    return { isValid: false, message: `${errorIcons.error} City name should contain only letters and spaces` };
                }
                if (value.length > 50) {
                    return { isValid: false, message: `${errorIcons.warning} City name should not exceed 50 characters` };
                }
                return { isValid: true };
            }
        }
    };

    // Form Data Object
    const formData = {};

    // Validate each field
    for (const [field, rules] of Object.entries(validationRules)) {
        const value = rules.getValue(rules.element);
        formData[field] = value;

        const validation = rules.validate(value);
        if (!validation.isValid) {
            isValid = false;
            showError(`error-${field}`, validation.message);
            highlightField(rules.element, 'error');
        } else {
            clearError(`error-${field}`);
            highlightField(rules.element, 'success');
        }
    }

    if (!isValid) {
        showErrorNotification('Please fix the errors in the form', 'error');
        return;
    }

    try {
        const submitButton = event.target;
        submitButton.disabled = true;
        submitButton.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving...';
        const response = await fetch(`/address?id=${userId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
        });
        const data = await response.json();

        if (response.ok) {
            showSuccessNotification('Address added successfully!', 'success');
            // const modal = bootstrap.Modal.getInstance(document.getElementById('addAddress'));
            // if (modal) modal.hide();
            
            setTimeout(() => location.reload(), 1500);
        } else {
            throw new Error(data.message || 'Failed to add address');
        }
    } catch (error) {
        console.error('Error:', error);
        showErrorNotification(error.message || 'Something went wrong!', 'error');
    } finally {
        // Reset button state
        submitButton.disabled = false;
        submitButton.innerHTML = 'Submit';
    }
}

// Enhanced error display function
function showError(id, message) {
    const errorElement = document.getElementById(id);
    if (errorElement) {
        errorElement.textContent = message;
        errorElement.style.color = "#dc3545";
        errorElement.style.fontSize = "12px";
        errorElement.style.marginTop = "4px";
        errorElement.style.display = "block";
    }
}

function clearError(id) {
    const errorElement = document.getElementById(id);
    if (errorElement) {
        errorElement.textContent = "";
        errorElement.style.display = "none";
    }
}

function highlightField(element, status) {
    if (element) {
        element.style.borderColor = status === 'error' ? "#dc3545" : "#198754";
        element.style.boxShadow = status === 'error' 
            ? "0 0 0 0.2rem rgba(220, 53, 69, 0.25)"
            : "0 0 0 0.2rem rgba(25, 135, 84, 0.25)";
    }
}

function showSuccessNotification(message) {
            Swal.fire({
                title: 'Success',
                text: message,
                icon: 'success',
                position: 'top',
                toast: true,
                showConfirmButton: false,
                timer: 1500,
                timerProgressBar: true,
                showClass: {
                    popup: 'animate__animated animate__fadeInDown'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp'
                },
                background: '#fff',
                color: '#1a1a1a',
                iconColor: '#4CAF50',
                customClass: {
                    popup: 'premium-toast',
                    title: 'premium-title',
                    timerProgressBar: 'premium-progress'
                }
    })
}


function showErrorNotification(message) {

    Swal.fire({
        title: 'Error',
        text: message || 'Verification failed',
        icon: 'error',
        position: 'top',
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        showClass: {
            popup: 'animate__animated animate__shakeX'
        },
        hideClass: {
            popup: 'animate__animated animate__fadeOutUp'
        },
        background: '#fff',
        color: '#1a1a1a',
        iconColor: '#FF3B30',
        customClass: {
            popup: 'premium-error-toast',
            title: 'premium-error-title',
            timerProgressBar: 'premium-error-progress'
        }
    });
}



function placeOrder(e,userId) {
    e.preventDefault();
    let isvaild = true; // Correct spelling

    // Get selected address
    const selectedAddress = document.querySelector('input[name="flexRadioDefault"]:checked');
    if (!selectedAddress) {
        isvaild = false;
        showErrorNotification("Please select a delivery address");
    }

    let Address = {};
    if (isvaild) {
        const addressBox = selectedAddress.closest('.delivery-address-box');
        Address = {
            id: selectedAddress.value,
            name: addressBox.querySelector('.name').innerText,
            address: addressBox.querySelector('.address p').innerText,
            pincode: addressBox.querySelector('.address span:nth-child(3)').innerText.split(":")[1].trim(),
            phone: addressBox.querySelector('.address span:nth-child(4)').innerText.split(":")[1].trim()
        };
    }

    // Get selected payment method
    const selectedPayment = document.querySelector('input[name="checkbox3"]:checked');
    if (!selectedPayment) {
        isvaild = false;
        showErrorNotification("Please select a payment method");
    }

    let paymentDetails = {};
    if (isvaild) {
        paymentDetails = {
            method: selectedPayment.nextElementSibling.innerText.trim(),
            id: selectedPayment.value
        };
    }

    // Get cart items
    const cartItems = [];
    const items = document.querySelectorAll('.qty li');

    if (items.length === 0) {
        isvaild = false;
        showErrorNotification("Cart is empty");
    }

    if (isvaild) {
        items.forEach(item => {
            const price = item.querySelector('h5').innerText.split("Rs:")[1].split("x")[0].trim();
            const color = item.querySelector('p')?.innerText.trim() || "N/A";
            const size = item.querySelector('h6')?.innerText.trim() || "N/A";
            const verientId = item.querySelector("#veraent-Id")?.value || "";
            const quantity = item.querySelector('h5').innerText.split("x")[1].trim();

            cartItems.push({
                name: item.querySelector('h4').innerText,
                color:color,
                size:size,
                verientId:verientId,
                price: parseFloat(price),
                quantity: parseInt(quantity),
                total: parseFloat(item.querySelector('.text-theme').innerText.split("Rs :")[1].trim()),
                image: item.querySelector('img').src
            });
        });
    }

    if (!isvaild) return;

    fetch(`/placeOrder?id=${userId}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
            address: Address,
            payment: paymentDetails,
            cartItems: cartItems
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showSuccessNotification("Order placed successfully!");
            window.location.href = "/order-success"; // Redirect to success page
        } else {
            showErrorNotification("Error placing order: " + data.message);
        }
    })
    .catch(error => {
        console.error("Error:", error);
        showErrorNotification("Something went wrong. Please try again.");
    });
}

    </script>
