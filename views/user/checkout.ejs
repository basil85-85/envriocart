async function applyCoupon() {
    try {
        let couponInput = document.getElementById("coupon");
        let applyBtn = document.getElementById("apply-btn");
        let removeBtn = document.getElementById("remove-btn");
        
        let isValid = true;
        let totalValue = document.getElementById("totalCartPrice");
        let cartValue = parseFloat(totalValue.textContent.replace("Rs : ", "").trim());

        let couponCode = document.getElementById("coupon").value;
        if (couponCode === "") {
            showError("error-couponCode", "Enter the code here!! It is empty!!!");
            isValid = false;
        } else {
            clearError("error-couponCode");
        }

        if (!isValid) return;

        const response = await fetch("/checkout/applyCoupon", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ couponCode })
        });

        let data;
        try {
            data = await response.json();
        } catch {
            showErrorNotification("Invalid response from server");
            return;
        }

       
            if (data.success) {
                showSuccessNotification(data.message);
                // console.log("Final Price:", data.finalPrice);
                totalValue.innerHTML = `Rs : ${data.finalPrice}.00`;
                document.getElementById("CouponOffer").innerText =`RS :${data.discountAmount}`
                couponInput.disabled = true;
                 applyBtn.style.display = "none";
                 removeBtn.style.display = "inline-block";
             
            } else {
                showErrorNotification(data.message); 
            }
        } 

    catch (error) {
        showErrorNotification(error.toString());
    }
}

