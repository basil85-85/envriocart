                                        <div class="custom-box-loader">
                                            <ul class="sub-total">
                                                <li>Sub Total <span class="count">Rs : <%=cart.totalPrice  %> .00</span></li>
                                                <li> Shipping <span class="count">Rs: 0.00</span></li>
