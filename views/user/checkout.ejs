                                                                    </h6>
                                                                    <a class="btn theme-btn border-btn copy-btn mt-0"
                                                                        href="#!">Copy Code</a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <div class="coupon-box">
                                                            <div class="card-name">
                                                                <h6>Holiday Savings</h6>
                                                            </div>
                                                            <div class="coupon-content">
                                                                <div class="coupon-apply">
                                                                    <h6 class="coupon-code success-color">#HOLIDAY40
