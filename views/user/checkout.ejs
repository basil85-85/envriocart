                                                    <button type="button" onclick="applyCoupon()" class="apply-button btn" id="apply-btn">Apply now</button>
                                                    <button type="button" onclick="removeCoupon()" 
                                                    class="remove-button btn" id="remove-btn" 
                                                    style="display: none; background: rgb(218, 11, 11); color: white; 
                                                           border: none; padding: 5px 10px; border-radius: 5px; 
                                                           transition: all 0.3s ease-in-out; font-weight: bold;">
                                                    <i class="bi bi-trash delete-icon" 
                                                       style="margin-right: 5px; font-size: 18px;"></i> Remove
