                                                    <img src="<%= img %>" 
                                                    id="thumbnail<%= i %>-image<%= index %>"
                                                         class="" style="width:100%;height: 100%;">
                                                </div>
                                            <% }); %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } %>
                    <% } %>
            
             
