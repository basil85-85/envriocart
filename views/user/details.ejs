function initMagnifier() {
    const productSlicks = document.querySelectorAll('.product-slick');
    
    productSlicks.forEach(slick => {
        const img = slick.querySelector('img');
        const magnifierSize = 150; // Size of the magnifier lens
        
        // Create magnifier lens element
        const lens = document.createElement('div');
        lens.classList.add('magnifier-lens');
        slick.appendChild(lens);
        
        // Create magnified view container
        const magnifiedView = document.createElement('div');
        magnifiedView.classList.add('magnified-view');
        slick.appendChild(magnifiedView);
        
        // Calculate magnified image position
        function getMagnifiedPosition(e) {
            const rect = slick.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            // Calculate position as percentage
            const xPercentage = (x / rect.width) * 100;
            const yPercentage = (y / rect.height) * 100;
            
            return { x, y, xPercentage, yPercentage };
        }
        
        // Update magnifier and magnified view
        function updateMagnifier(e) {
            const pos = getMagnifiedPosition(e);
            
            // Position the lens
            const lensLeft = pos.x - magnifierSize / 2;
            const lensTop = pos.y - magnifierSize / 2;
            
            lens.style.left = `${lensLeft}px`;
            lens.style.top = `${lensTop}px`;
            
            // Update magnified view
            magnifiedView.style.backgroundImage = `url(${img.src})`;
            magnifiedView.style.backgroundPosition = `${pos.xPercentage}% ${pos.yPercentage}%`;
        }
        
        // Event listeners
        slick.addEventListener('mousemove', (e) => {
            lens.style.display = 'block';
            magnifiedView.style.display = 'block';
            updateMagnifier(e);
        });
        
        slick.addEventListener('mouseleave', () => {
            lens.style.display = 'none';
            magnifiedView.style.display = 'none';
        });
    });
}

// Initialize magnifier when DOM is loaded
document.addEventListener('DOMContentLoaded', initMagnifier);

// Call initMagnifier after changing images
function changeMainImage(index, variantIndex) {
    const mainImage = document.getElementById(`main-image${variantIndex}`);
    const thumbnailImage = document.getElementById(`thumbnail${variantIndex}-image${index}`);
    mainImage.src = thumbnailImage.src;
    
    // Update active thumbnail
    const thumbnails = document.querySelectorAll(`#product-images-cont${variantIndex} .thumbnail-item`);
    thumbnails.forEach(thumb => thumb.classList.remove('active'));
    thumbnailImage.parentElement.classList.add('active');
    
    // Reinitialize magnifier for new image
    initMagnifier();
}


