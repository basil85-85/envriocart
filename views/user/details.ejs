document.addEventListener('DOMContentLoaded', function() {
    // Get all quantity selectors on the page
    const quantitySelectors = document.querySelectorAll('.qty-section');
    
    quantitySelectors.forEach(selector => {
        const minusButton = selector.querySelector('.quantity-left-minus');
        const plusButton = selector.querySelector('.quantity-right-plus');
        const input = selector.querySelector('.input-number');
        
        // Set initial state of minus button
        minusButton.disabled = input.value <= input.getAttribute('min');
        
        // Minus button click handler
        minusButton.addEventListener('click', function(e) {
            e.preventDefault();
            let currentValue = parseInt(input.value);
            if (currentValue > parseInt(input.getAttribute('min'))) {
                input.value = currentValue - 1;
                // Enable plus button
                plusButton.disabled = false;
            }
            // Disable minus button at min value
            if (input.value <= input.getAttribute('min')) {
                minusButton.disabled = true;
            }
        });
        
        // Plus button click handler
        plusButton.addEventListener('click', function(e) {
            e.preventDefault();
            let currentValue = parseInt(input.value);
            if (currentValue < parseInt(input.getAttribute('max'))) {
                input.value = currentValue + 1;
                // Enable minus button
                minusButton.disabled = false;
            }
            // Disable plus button at max value
            if (input.value >= input.getAttribute('max')) {
                plusButton.disabled = true;
            }
        });
        
        // Input change handler
        input.addEventListener('change', function() {
            let value = parseInt(this.value);
            const min = parseInt(this.getAttribute('min'));
            const max = parseInt(this.getAttribute('max'));
            
            // Ensure value stays within bounds
            if (value < min) {
                this.value = min;
            } else if (value > max) {
                this.value = max;
            }
        });
    });

  

