function initMagnifier() {
    const productSlicks = document.querySelectorAll('.product-slick');
    
    productSlicks.forEach(slick => {
        const img = slick.querySelector('img');
        const magnifierSize = 150; // Size of the magnifier lens
        
        // Create magnifier lens element
        const lens = document.createElement('div');
        lens.classList.add('magnifier-lens');
        slick.appendChild(lens);
        
        // Create magnified view container
        const magnifiedView = document.createElement('div');
        magnifiedView.classList.add('magnified-view');
        slick.appendChild(magnifiedView);
        
        // Calculate magnified image position
        function getMagnifiedPosition(e) {
            const rect = slick.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            // Calculate position as percentage
            const xPercentage = (x / rect.width) * 100;
            const yPercentage = (y / rect.height) * 100;
            
            return { x, y, xPercentage, yPercentage };
        }
        
        // Update magnifier and magnified view
        function updateMagnifier(e) {
            const pos = getMagnifiedPosition(e);
            
            // Position the lens
            const lensLeft = pos.x - magnifierSize / 2;
            const lensTop = pos.y - magnifierSize / 2;
            
            lens.style.left = `${lensLeft}px`;
            lens.style.top = `${lensTop}px`;
            
            // Update magnified view
            magnifiedView.style.backgroundImage = `url(${img.src})`;
            magnifiedView.style.backgroundPosition = `${pos.xPercentage}% ${pos.yPercentage}%`;
        }
        
        // Event listeners
        slick.addEventListener('mousemove', (e) => {
            lens.style.display = 'block';
            magnifiedView.style.display = 'block';
            updateMagnifier(e);
        });
        
        slick.addEventListener('mouseleave', () => {
            lens.style.display = 'none';
            magnifiedView.style.display = 'none';
        });
    });
}

document.addEventListener('DOMContentLoaded', initMagnifier);


function changeMainImage(index, variantIndex) {
    const mainImage = document.getElementById(`main-image${variantIndex}`);
    const thumbnailImage = document.getElementById(`thumbnail${variantIndex}-image${index}`);
    mainImage.src = thumbnailImage.src;
    
    // Update active thumbnail
    const thumbnails = document.querySelectorAll(`#product-images-cont${variantIndex} .thumbnail-item`);
    thumbnails.forEach(thumb => thumb.classList.remove('active'));
    thumbnailImage.parentElement.classList.add('active');
    
    initMagnifier();
}


document.addEventListener('DOMContentLoaded', () => {
    const sizeSelectors = document.querySelectorAll('.size-selector');
    const stockInfoElements = document.querySelectorAll('.stock-info');

    function updateStockDisplay(select) {
        stockInfoElements.forEach(el => el.style.display = 'none');

        const selectedSize = select.value;
        const stockInfo = document.querySelector(`.stock-info[data-size="${selectedSize}"]`);
        if (stockInfo) {
            stockInfo.style.display = 'inline';
        }
    }

    sizeSelectors.forEach(select => {
        select.addEventListener('change', () => {
            updateStockDisplay(select);
        });

        if (select.selectedIndex !== -1) {
            updateStockDisplay(select);
        }
    });
});

let cart = [];

function addToCart() {
    // Get active variant index from the selected color button
    const activeVariantIndex = document.querySelector('.color-variant .active button')?.getAttribute('onclick')?.match(/'(\d+)'/)[1];
    
    if (activeVariantIndex === undefined) {
        showErrorNotification('Please select a variant.');
        return;
    }
    const activeColorButton = document.querySelector('.color-variant .active button');
    const variantId = document.getElementById(`variant-id-${activeVariantIndex}`).value;
    if (!variantId) {
        showErrorNotification('Variant ID not found.');
        return;
    }

    const sizeSelector = document.querySelector(`#product-size-cont${activeVariantIndex} .size-selector`);
    if (!sizeSelector) {
        showErrorNotification("Out of the Stock")
        return;
    }
    const selectedSize = sizeSelector.value;
    const stockElement = document.querySelector(`.stock-info[data-size="${selectedSize}"]`);
    const stock = stockElement ? parseInt(stockElement.innerText) : 0;
    
    if (stock <= 0) {
        alert('Selected size is out of stock.');
        return;
    }

    const cartItem = {
        variantId,
        productName: document.querySelector('.main-title').innerText,
        size: selectedSize,
        color:activeColorButton.getAttribute('data-color'),
        price: parseFloat(document.querySelector('.price-text h3').innerText.replace('Rs:', '').trim()),
        image: document.querySelector(`#main-image${activeVariantIndex}`).src,
        quantity: 1
    };


    const existingItem = cart.find(item => 
        item.variantId === cartItem.variantId && 
        item.size === cartItem.size
    );

    if (existingItem) {
        existingItem.quantity += 1;
    } else {
        cart.push(cartItem);
    }
    updateCartDisplay()
    fetch('/addCart', {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(cartItem)
})
.then(response => response.json())  
.then(data => {
    if (data && data.success) {  
        showSuccessNotification(data.message);
    } else {
        showErrorNotification(data.message || "Something went wrong");
    }
})
.catch(error => {
    console.error("Fetch Error:", error);
    showErrorNotification("You are not logged in, please login.");
    setTimeout(()=>{
        window.location.href = '/login';
    },1500)
});
}

function updateCartDisplay() {
    const cartCount = cart.reduce((total, item) => total + item.quantity, 0);
    document.getElementById('cart-count').innerText = cartCount;
    
  
}

