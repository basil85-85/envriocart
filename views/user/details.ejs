                                    <ul class="color-variant custom-variations d-flex">
                                        <% products.variants.forEach((variant, index) => { %>
                                            <% if (variant.productcolor) { %>
                                                <li class="<%= index === 0 ? 'active' : '' %>">
                                                    <button 
                                                        type="button"
                                                        data-color="<%= variant.productcolor %>"
                                                        onclick="variantDynamicDisplay('<%= index %>')"
                                                        class="color-selector circle"
                                                        style="background-color: <%= variant.productcolor %>; border: 2px solid #ddd;"
                                                        title="<%= variant.productcolor %>"
                                                    >
                                                    </button>
                                                </li>
                                            <% } %>
                                        <% }) %>
                                    </ul>
                                </div>
                                
                            <% } %>
                            <hr>
                            <div class="product-variants-container">
                                <% 
                                const sizeOrder = ['S', 'M', 'L', 'XL', 'XXL'];
                            
                                products.variants.forEach((variant, variantIndex) => { 
                                    const availableSizes = sizeOrder.filter(size => 
                                        variant.size && 
                                        Object.keys(variant.size).includes(size) && 
                                        variant.size[size] > 0
                                    );
                                %>
                                    <div 
                                        class="product-size-cont <%= variantIndex === 0 ? '' : 'display-none' %>" 
                                        id="product-size-cont<%= variantIndex %>"
                                    >
                                    <%  if( availableSizes.length>0) {  %>
                                        <div class="variation-box size-box mt-2 " style="width: 40%;">
                                            <h4 class="sub-title">Size:</h4>
                                            <select 
                                                class="size-selector form-control form-control-sm"
                                                data-variant-index="<%= variantIndex %>"
                                                style="font-size: 16px; padding: 10px;"
                                            >
                                           
                                                <% availableSizes.forEach((size, index) => { 
                                                    const stock = variant.size[size];
                                                %>
                                                    <option
                                                        value="<%= size %>"
                                                        data-stock="<%= stock %>"
                                                        <%= index === 0 ? 'selected' : '' %>
                                                    >
                                                        <%= size %>
                                                    </option>
                                                <% }); %>
                                            </select>
                                          

                                         
                                            <div class="stock-availability">
                                                <% availableSizes.forEach((size) => { 
                                                    const stock = variant.size[size];
                                                %>
                                                    <span 
                                                        class="stock-info" 
                                                        data-size="<%= size %>"
                                                        style="color: green;"
                                                    >
                                                        <%= stock %> available
                                                    </span>
                                                <% }); %>
                                            </div>
                                          
                                        </div>
                                        <% } else { %>
                                            <p class="out-of-stock-badge">Out of Stock</p>
                                        <% } %>
                                    </div>
                                <% }); %>
                            </div>
                            <span id="cart-count" hidden></span>
                            <% products.variants.forEach((variant, index) => { %>
