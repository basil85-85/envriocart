                                                 alt="Product Image">
                                        </div>
                               
                                </div>
                        
                                <!-- Thumbnail Navigation -->
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <div class="slider-nav">
                                            <% products.variants[i].productImg.forEach((img, index) => { %>
