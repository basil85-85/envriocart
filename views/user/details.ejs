let wishlist = [];

function addWishlist() {
    const activeVariantButton = document.querySelector('.color-variant .active button');
    
    if (!activeVariantButton) {
        showErrorNotification('Please select a variant.');
        return;
    }

    const activeVariantIndex = activeVariantButton.getAttribute('onclick')?.match(/'(\d+)'/)[1];

    const variantIdInput = document.getElementById(`variant-id-${activeVariantIndex}`);
    if (!variantIdInput) {
        showErrorNotification('Variant ID not found.');
        return;
    }
    const variantId = variantIdInput.value;

    // Find size selector if it exists
    const sizeSelector = document.querySelector(`#product-size-cont${activeVariantIndex} .size-selector`);
    const selectedSize = sizeSelector ? sizeSelector.value : null; // If no size is selected, it remains null

    const wishlistItem = {
        variantId,
        productName: document.querySelector('.main-title').innerText,
        size: selectedSize,
        color: activeVariantButton.getAttribute('data-color'),
        price: parseFloat(document.querySelector('.price-text h3').innerText.replace('Rs:', '').trim()),
        image: document.querySelector(`#main-image${activeVariantIndex}`).src
    };

    // Check if the item already exists in the wishlist
    const existingItem = wishlist.find(item => 
        item.variantId === wishlistItem.variantId && 
        item.size === wishlistItem.size
    );

    if (existingItem) {
        showErrorNotification("Item already exists in wishlist.");
        return;
    }

    wishlist.push(wishlistItem);

    // Send data to the backend
    fetch('/addWishlist', {  // 🔥 Corrected API route name
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(wishlistItem)
    })
    .then(response => response.json())  
    .then(data => {
        if (data && data.success) {  
            showSuccessNotification(data.message);
        } else {
            showErrorNotification(data.message || "Something went wrong");
        }
    })
    .catch(error => {
        console.error("Fetch Error:", error);
        showErrorNotification("You are not logged in, please login.");
        setTimeout(() => {
            window.location.href = '/login';
        }, 1500);
    });
}

