<style>

.product-gallery {
        position: relative;
        margin-bottom: 30px;
    }

    /* .product-slick {
        border: 1px solid #eee;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 10px;
    } */

    .product-image-item {
        position: relative;
        padding-top: 100%; /* 1:1 Aspect Ratio */
        overflow: hidden;
    }

    .product-image-item img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .product-image-item img:hover {
        transform: scale(1.05);
    }

    .slider-nav {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 10px 0;
        scrollbar-width: none; /* Firefox */
    }

    .slider-nav::-webkit-scrollbar {
        display: none; /* Chrome, Safari, Edge */
    }

    .thumbnail-item {
        flex: 0 0 80px;
        height: 80px;
        border-radius: 4px;
        overflow: hidden;
        cursor: pointer;
        border: 2px solid transparent;
        transition: border-color 0.3s ease;
    }

    .thumbnail-item.active {
        border-color: #2874f0;
    }

    .thumbnail-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .color-selector{
        width: 30px;
        height: 30px;
        border-radius: 10px;
    }
    .display-none {
        display: none;
    }

 /* Add these styles to your existing CSS */
.product-slick {
    position: relative;
    cursor: none; /* Hide default cursor when hovering */
}

.magnifier-lens {
    position: absolute;
    width: 150px;
    height: 150px;
    border: 2px solid #ffffff;
    border-radius: 50%;
    pointer-events: none;
    display: none;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.3);
    background: rgba(255,255,255,0.1);
}

.magnified-view {
    position: absolute;
    width: 300px;
    height: 300px;
    border: 1px solid #ddd;
    background-repeat: no-repeat;
    background-size: 400% 400%;
    display: none;
    pointer-events: none;
    z-index: 100;
    right: -320px;
    top: 0;
    box-shadow: 2px 2px 8px rgba(0,0,0,0.1);
}

@media (max-width: 1200px) {
    .magnified-view {
        display: none !important;
    }
    
    .magnifier-lens {
        display: none !important;
    }
    
    .product-slick {
        cursor: zoom-in;
    }
}
    

</style>

