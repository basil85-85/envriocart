<!DOCTYPE html>
<html>
<head>
    <title>Google Sign-In</title>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        .data {
            display: none;
            margin: 20px;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        .user-info {
            margin: 10px 0;
        }
        .sign-out-btn {
            margin-top: 20px;
            padding: 10px 20px;
            background-color: #dc3545;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <!-- Google Sign-In button container -->
    <div id="signInDiv"></div>

    <!-- User data display -->
    <div class="data">
        <div class="user-info">
            <h3>Profile Details</h3>
            <p>Name: <span id="name"></span></p>
            <p>Email: <span id="email"></span></p>
            <img id="profile-image" src="" alt="Profile Image" style="display: none;">
        </div>
        <button onclick="handleSignOut()" class="sign-out-btn">Sign Out</button>
    </div>

    <script>
    let tokenClient;

    window.onload = function () {
        google.accounts.id.initialize({
            client_id: '922178953334-6dbpoiajcqqshesvae72v5435igr37q7.apps.googleusercontent.com',
            callback: handleCredentialResponse,
            auto_select: false,
            cancel_on_tap_outside: true
        });

        google.accounts.id.renderButton(
            document.getElementById('signInDiv'),
            { 
                theme: 'outline', 
                size: 'large',
                type: 'standard',
                shape: 'rectangular',
                text: 'signin_with',
                logo_alignment: 'left'
            }
        );

        // Display One Tap prompt if not signed in
        google.accounts.id.prompt();
    };

    function handleCredentialResponse(response) {
        const token = response.credential;
        
        // Decode the JWT token to display user info immediately
        const payload = JSON.parse(atob(token.split('.')[1]));
        
        // Update UI with user info
        updateUserInterface(payload);
        
        // Send token to backend
        fetch('/auth/google', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ token: token }),
            credentials: 'include' // Important for session handling
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Authentication failed');
            }
            return response.json();
        })
        .then(data => {
            if (!data.success) {
                throw new Error(data.message || 'Authentication failed');
            }
            console.log('Successfully authenticated with backend');
        })
        .catch(error => {
            console.error('Auth Error:', error);
            alert('Authentication failed: ' + error.message);
            handleSignOut(); // Clean up UI if backend auth fails
        });
    }

    function updateUserInterface(payload) {
        $("#name").text(payload.name);
        $("#email").text(payload.email);
        
        if (payload.picture) {
            $("#profile-image")
                .attr('src', payload.picture)
                .css('display', 'block');
        }

        $(".data").css("display", "block");
        $("#signInDiv").css("display", "none");
    }

    function handleSignOut() {
        // Revoke Google authentication
        google.accounts.id.disableAutoSelect();
        
        // Clear session with backend
        fetch('/auth/signout', {
            method: 'POST',
            credentials: 'include'
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Signout failed');
            }
            return response.json();
        })
        .then(() => {
            // Reset UI
            $(".data").css("display", "none");
            $("#signInDiv").css("display", "block");
            $("#profile-image").css("display", "none");
            
            // Clear stored data
            $("#name").text('');
            $("#email").text('');
            $("#profile-image").attr('src', '');
            
            // Show sign-in button again
            google.accounts.id.renderButton(
                document.getElementById('signInDiv'),
                { 
                    theme: 'outline', 
                    size: 'large' 
                }
            );
            
            // Optional: Show One Tap prompt again
            google.accounts.id.prompt();
        })
        .catch(error => {
            console.error('Signout Error:', error);
            alert('Sign-out failed: ' + error.message);
        });
    }
    </script>
</body>
</html>