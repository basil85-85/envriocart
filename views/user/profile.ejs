   function ChangePassword(event) {
    event.preventDefault();
    
    let oldPassword = document.getElementById("current").value.trim();
    let newPassword = document.getElementById("New").value.trim();
    let confirmPassword = document.getElementById("Confirm").value.trim();
    let errorElement = document.getElementById("error-password");
  
    let isValid = true;
    clearError("error-password")
    const passwordRegex = /^(?=.*[A-Z])(?=.*[0-9])(?=.*[!@#$%^&*])[A-Za-z\d!@#$%^&*]{8,}$/;

    if (!oldPassword || !newPassword || !confirmPassword) {
        showError("error-password", "All fields are required.");
        isValid = false;
    }

    if (newPassword && !passwordRegex.test(newPassword)) {
        showError("error-password", "New password must be at least 8 characters long, contain at least one uppercase letter, one number, and one special character (!@#$%^&*).");
        isValid = false;
    }

    if (newPassword !== confirmPassword) {
        showError("error-password", "New password and confirm password do not match.");
        isValid = false;
    }

    if (!isValid) {
        return;
    }

    const formData = {
        oldPassword,
        newPassword
    };

    fetch("/changePassword?id=<%=details._id%>", {
        method: "PUT",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showSuccessNotification("Password changed successfully!");
            setTimeout(() => {
                location.reload();
            }, 1500);
        } else {
            showErrorNotification( data.message || "Failed to change password.");
        }
    })
    .catch(error => {
        showErrorNotification("error-password", "An error occurred. Please try again.");
    });
}

// Animation styles
const styles = `
<style>
.input-shake {
    animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
}

.success-checkmark {
    animation: scaleCheckmark 0.3s ease-in-out forwards;
}

.fade-out {
    animation: fadeOut 0.5s ease-out forwards;
}

@keyframes shake {
    10%, 90% { transform: translateX(-1px); }
    20%, 80% { transform: translateX(2px); }
    30%, 50%, 70% { transform: translateX(-4px); }
    40%, 60% { transform: translateX(4px); }
}

@keyframes scaleCheckmark {
    0% { transform: scale(0); }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); }
}

@keyframes fadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
}

.field-animation {
    transition: all 0.3s ease;
}

.field-success {
    border-color: #28a745 !important;
    box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
}

.field-error {
    border-color: #dc3545 !important;
    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
}
</style>
`;

// Add styles to document
document.head.insertAdjacentHTML('beforeend', styles);

// Function to validate fields with animation
function validateField(id, value, errorId, errorMessage, regexOrFunc = v => v.trim() !== "") {
    const field = document.getElementById(id);
    const isValid = typeof regexOrFunc === "function" ? regexOrFunc(value) : regexOrFunc.test(value);
    
    if (!isValid) {
        showError(errorId, errorMessage);
        field.classList.add('field-animation', 'field-error', 'input-shake');
        field.addEventListener('animationend', () => {
            field.classList.remove('input-shake');
        });
        return false;
    } else {
        clearError(errorId);
        field.classList.remove('field-error');
        field.classList.add('field-animation', 'field-success');
        return true;
    }
}

// Enhanced error display function
function showError(elementId, message) {
    const errorElement = document.getElementById(elementId);
    if (errorElement) {
        errorElement.innerHTML = `<span class="error-icon">❌</span> ${message}`;
        errorElement.style.opacity = '0';
        errorElement.style.display = 'block';
        setTimeout(() => {
            errorElement.style.opacity = '1';
        }, 10);
    }
}

// Enhanced error clear function
function clearError(elementId) {
    const errorElement = document.getElementById(elementId);
    if (errorElement) {
        errorElement.classList.add('fade-out');
        setTimeout(() => {
            errorElement.textContent = '';
            errorElement.classList.remove('fade-out');
        }, 500);
    }
}

// Success notification with animation
function showSuccessNotification(message) {
    const notification = document.createElement('div');
    notification.style.cssText = `
        position: fixed;
        top: 20px;
        right: 20px;
        background: #28a745;
        color: white;
        padding: 15px 25px;
        border-radius: 5px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 10px;
        transform: translateX(100%);
        transition: transform 0.3s ease-out;
    `;
    
    notification.innerHTML = `
        <span class="success-checkmark">✓</span>
        <span>${message}</span>
    `;
    
    document.body.appendChild(notification);
    
    requestAnimationFrame(() => {
        notification.style.transform = 'translateX(0)';
    });

    setTimeout(() => {
        notification.style.transform = 'translateX(100%)';
        setTimeout(() => notification.remove(), 300);
    }, 3000);
}

// Error notification with animation
function showErrorNotification(message) {
    const notification = document.createElement('div');
    notification.style.cssText = `
        position: fixed;
        top: 20px;
        right: 20px;
        background: #dc3545;
        color: white;
        padding: 15px 25px;
        border-radius: 5px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 10px;
        transform: translateX(100%);
        transition: transform 0.3s ease-out;
    `;
    
    notification.innerHTML = `
        <span class="error-icon">⚠️</span>
        <span>${message}</span>
    `;
    
    document.body.appendChild(notification);
    
    requestAnimationFrame(() => {
        notification.style.transform = 'translateX(0)';
    });

    setTimeout(() => {
        notification.style.transform = 'translateX(100%)';
        setTimeout(() => notification.remove(), 300);
    }, 3000);
}

// Main address validation and submission function
function addAddress(event,details) {
    event.preventDefault();
    let isValid = true;

    // Get form values
    let title = document.getElementById("title").value.trim();
    let address = document.getElementById("Address").value.trim();
    let phone = document.getElementById("Adphone").value.trim();
    let country = document.getElementById("input-state-02").value;
    let state = document.getElementById("input-state-04").value;
    let city = document.getElementById("City").value.trim();
    let pincode = document.getElementById("pincode").value.trim();

    // Validate each field with animations
    isValid = validateField("title", title, "error-title", "Title is required") && isValid;
    isValid = validateField("Address", address, "error-address", "Address is required") && isValid;
    isValid = validateField(
        "Adphone", 
        phone, 
        "error-phone", 
        "Enter a valid phone number (e.g. +91 9876543210)", 
        value => /^\d{10}$/.test(value)
    ) && isValid;
    isValid = validateField(
        "input-state-02", 
        country, 
        "error-country", 
        "Please select a country", 
        value => value !== "Select Country"
    ) && isValid;
    isValid = validateField(
        "input-state-04", 
        state, 
        "error-state", 
        "Please select a state", 
        value => value !== "Select State"
    ) && isValid;
    isValid = validateField("City", city, "error-city", "City is required") && isValid;
    isValid = validateField(
        "pincode", 
        pincode, 
        "error-pincode", 
        "Enter a valid Pin Code", 
        value => /^\d{4,6}$/.test(value)
    ) && isValid;

    if (isValid) {
        const formData = { title, address, phone, country, state, city, pincode };
        const submitButton = document.querySelector('.btn-solid');
         console.log(formData)
        // Add loading animation
        submitButton.disabled = true;
        submitButton.innerHTML = `
            <span class="spinner-border spinner-border-sm mr-2"></span>
            <span>Saving...</span>
        `;

        fetch(`/address?id=${details}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(formData)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                console.log(data)
                showSuccessNotification("Details updated successfully!");
                // Add success animation to form
                const form = document.querySelector('.modal-content');
                form.style.transition = 'transform 0.3s ease-out';
                form.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    location.reload();
                }, 1500);
            } else {
                showErrorNotification(data.message);
            }
        })
        .catch(error => {
            console.error("Error:", error);
            showErrorNotification("Something went wrong. Please try again later.");
        })
        .finally(() => {
            submitButton.disabled = false;
            submitButton.innerHTML = 'Submit';
        });
    }
}

// Add input event listeners for real-time validation
document.addEventListener('DOMContentLoaded', () => {
    const fields = ['title', 'Address', 'Adphone', 'input-state-02', 'input-state-04', 'City', 'pincode'];
    
    fields.forEach(fieldId => {
        const element = document.getElementById(fieldId);
        if (element) {
            element.addEventListener('input', (e) => {
                element.classList.add('field-animation');
                validateField(fieldId, e.target.value, `error-${fieldId.toLowerCase()}`, 
                    element.getAttribute('data-error-message') || 'This field is required');
            });
        }
    });
});

function deleteAddress(addressid) {
    Swal.fire({
        title: "Are you sure?",
        text: "Do you really want to delete this address? This action cannot be undone!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Yes, delete it!"
    }).then((result) => {
        if (result.isConfirmed) {
            fetch(`/deleteAddress?id=${encodeURIComponent(addressid)}`, {
                method: "DELETE"
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! Status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    showSuccessNotification("Deleted!", "Your address has been deleted.", "success")
                    setTimeout(()=>{
                        location.reload()
                    },1500)
                       
                } else {
                    showErrorNotification("Error!", data.message || "Failed to delete address.", "error");
                }
            })
            .catch(error => {
                console.error("Error:", error);
                showErrorNotification("Error!", "Something went wrong.", "error");
            });
        }
    });
}




document.addEventListener("DOMContentLoaded", function () {
    let activeTab = localStorage.getItem("activeTab"); // Retrieve the stored tab

    if (activeTab) {
        let tabElement = document.querySelector(`[data-bs-target="${activeTab}"]`);
        if (tabElement) {
            let tab = new bootstrap.Tab(tabElement);
            tab.show();
        }
    }

    // Store the clicked tab in localStorage
    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
        tab.addEventListener("click", function (event) {
            localStorage.setItem("activeTab", event.target.getAttribute("data-bs-target"));
        });
    });
});



function populateEditForm(addressData) {
    let add = JSON.parse(addressData); 

    document.getElementById("title2").value = add.title || "";
    document.getElementById("name6").value = add.address || "";
    document.getElementById("city2").value = add.city || "";
    document.getElementById("pincode2").value = add.pincode || "";
    document.getElementById("name5").value = add.phone || "";

    document.getElementById("addressId").value = add._id || "";

    let stateDropdown = document.getElementById("input-state-ope").value=add.state ||"";
    for (let i = 0; i < stateDropdown.options.length; i++) {
        if (stateDropdown.options[i].text === add.state) {
            stateDropdown.options[i].selected = true;
            break;
        }
    }
}

