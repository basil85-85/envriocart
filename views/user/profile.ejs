<script>
function editDetails(event) {
    event.preventDefault(); 

    let isValid = true; // Fixed typo (was "isvaild")

    let name = document.getElementById("Dname").value.trim();
    let phone = document.getElementById("Dphone").value.trim();


    // Name validation
    if (name === "") {
        showError("error-Dname", "Name is required");
        isValid = false;
    } else {
        clearError("error-Dname");
    }

    // Phone validation (only if the user enters a phone number)
    if (phone !== "" && !/^\d{10}$/.test(phone)) {
        showError("error-Dphone", "Enter a valid 10-digit phone number");
        isValid = false;
    } else {
        clearError("error-Dphone");
    }


    if (!isValid) {
        return;
    }

    let userData = {
        name: name,
        phone: phone
    };

    fetch(`/profile?id=<%=details._id%>`, {
        method: "PUT",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify(userData)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showSuccessNotification("Details updated successfully!");
            setTimeout(() => {
                location.reload();
            }, 1500);
           
        } 
        else{
            showErrorNotification(data.message)
        }
    })
    .catch(error => {
        console.error("Error:", error);
        showErrorNotification("Something went wrong. Please try again later.");
    });
}

function showError(id, message) {
        const errorElement = document.getElementById(id);
        errorElement.textContent = message;
        errorElement.style.color = 'red';
    }

    function clearError(id) {
        const errorElement = document.getElementById(id);
        errorElement.textContent = '';
    }




    function showSuccessNotification() {
            Swal.fire({
                title: 'Success',
                text: 'Your email has been verified!',
                icon: 'success',
                position: 'top',
                toast: true,
                showConfirmButton: false,
                timer: 1500,
                timerProgressBar: true,
                showClass: {
                    popup: 'animate__animated animate__fadeInDown'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp'
                },
                background: '#fff',
                color: '#1a1a1a',
                iconColor: '#4CAF50',
                customClass: {
                    popup: 'premium-toast',
                    title: 'premium-title',
                    timerProgressBar: 'premium-progress'
                }
    })
}

// Error notification function
function showErrorNotification(message) {

    Swal.fire({
        title: 'Error',
        text: message || 'Verification failed',
        icon: 'error',
        position: 'top',
        toast: true,
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        showClass: {
            popup: 'animate__animated animate__shakeX'
        },
        hideClass: {
            popup: 'animate__animated animate__fadeOutUp'
        },
        background: '#fff',
        color: '#1a1a1a',
        iconColor: '#FF3B30',
        customClass: {
            popup: 'premium-error-toast',
            title: 'premium-error-title',
            timerProgressBar: 'premium-error-progress'
        }
    });
}




function ChangePassword(event) {
    event.preventDefault();
    
    let oldPassword = document.getElementById("current").value.trim();
    let newPassword = document.getElementById("New").value.trim();
    let confirmPassword = document.getElementById("Confirm").value.trim();
    let errorElement = document.getElementById("error-password");
  
    let isValid = true;
    clearError("error-password")
    const passwordRegex = /^(?=.*[A-Z])(?=.*[0-9])(?=.*[!@#$%^&*])[A-Za-z\d!@#$%^&*]{8,}$/;

    if (!oldPassword || !newPassword || !confirmPassword) {
        showError("error-password", "All fields are required.");
        isValid = false;
    }

    if (newPassword && !passwordRegex.test(newPassword)) {
        showError("error-password", "New password must be at least 8 characters long, contain at least one uppercase letter, one number, and one special character (!@#$%^&*).");
        isValid = false;
    }

    if (newPassword !== confirmPassword) {
        showError("error-password", "New password and confirm password do not match.");
        isValid = false;
    }

    if (!isValid) {
        return;
    }

    const formData = {
        oldPassword,
        newPassword
    };

    fetch("/changePassword?id=<%=details._id%>", {
        method: "PUT",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showSuccessNotification("Password changed successfully!");
            setTimeout(() => {
                location.reload();
            }, 1500);
        } else {
            showErrorNotification( data.message || "Failed to change password.");
        }
    })
    .catch(error => {
        showErrorNotification("error-password", "An error occurred. Please try again.");
    });
}


</script>



