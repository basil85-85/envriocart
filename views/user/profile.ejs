<%- include('../partial/user/header') %>

<style>


        /* Order Details Styling */
        .order-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 1.5rem;
            padding: 1rem;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .info-item {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .info-label {
            font-size: 0.875rem;
            color: #666;
            font-weight: 500;
        }

        .info-value {
            font-size: 1rem;
            color: #333;
            font-weight: 600;
        }

        /* Status Badge */
        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.35rem 0.75rem;
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-success {
            background: #d4edda;
            color: #155724;
        }

        .status-failed {
            background: #f8d7da;
            color: #721c24;
        }

        /* Animation */
        @keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: translate(-50%, -48%);
            }
            to {
                opacity: 1;
                transform: translate(-50%, -50%);
            }
        }

        .modal.active {
            animation: modalFadeIn 0.3s ease-out;
        }

      .table-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        padding: 1.5rem;
        margin: 2rem auto;
        overflow-x: auto;
    }

    .order-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .table-head {
        background: #f8fafc;
    }

    .order-table th {
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.875rem;
        letter-spacing: 0.05em;
        padding: 1rem;
        text-align: left;
        border-bottom: 2px solid #e2e8f0;
    }

    .order-table td {
        padding: 1rem;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.95rem;
    }

    .order-table tbody tr {
        transition: background-color 0.2s;
    }

    .order-table tbody tr:hover {
        background-color: #f8fafc;
    }

    .order-id {
        font-weight: 600;
        color: #1e293b;
        font-family: monospace;
        font-size: 1.1em;
    }

    .date {
        color: #64748b;
    }

    .amount {
        font-weight: 600;
        color: #047857;
    }

    .custom-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1;
    }

    .bg-pending {
        background-color: #fff7ed;
        color: #c2410c;
    }

    .bg-success {
        background-color: #f0fdf4;
        color: #15803d;
    }

    .bg-failed {
        background-color: #fef2f2;
        color: #dc2626;
    }

    .payment-method {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .action-btn {
        color: #3b82f6;
        padding: 0.5rem;
        border-radius: 6px;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        text-decoration: none;
    }

    .action-btn:hover {
        background-color: #eff6ff;
        color: #2563eb;
    }

    .action-btn i {
        font-size: 1.25rem;
    }

    /* Animation for new orders */
    @keyframes highlight {
        0% { background-color: #f0fdf4; }
        100% { background-color: transparent; }
    }

    .new-order {
        animation: highlight 2s ease-out;
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
        .table-container {
            margin: 1rem;
            padding: 1rem;
        }

        .order-table {
            font-size: 0.9rem;
        }

        .custom-badge {
            padding: 0.25rem 0.5rem;
        }
    }


  
        .pagination {
            display: flex;
            list-style: none;
            padding: 0;
            justify-content: center;
            gap: 5px;
            margin: 20px 0;
        }

        .page-item {
            margin: 0;
        }

        .page-link {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 35px;
            height: 35px;
            padding: 5px 10px;
            border: 1px solid #dee2e6;
            color: #007bff;
            text-decoration: none;
            border-radius: 4px;
            transition: all 0.2s;
        }

        .page-item.active .page-link {
            background-color: #007bff;
            border-color: #007bff;
            color: white;
        }

        .page-link:hover:not(.active) {
            background-color: #f8f9fa;
            border-color: #dee2e6;
            color: #0056b3;
        }

        .page-item.disabled .page-link {
            color: #6c757d;
            pointer-events: none;
            background-color: #fff;
            border-color: #dee2e6;
        }

        /* Icon styles */
        .pagination-icon {
            width: 16px;
            height: 16px;
            fill: currentColor;
        }
    
</style>
