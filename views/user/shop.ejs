    <script>



        let islogin =<%=isLoggedIn%>;

        if(islogin==false){
        $(window).on('load', function () {
             setTimeout(function () {
                $('#cybermonday').modal('show');
            }, 7500);
        });
    }
        function openSearch() {
            document.getElementById("search-overlay").style.display = "block";
        }

        function closeSearch() {
            document.getElementById("search-overlay").style.display = "none";
        }

        document.getElementById("sortOption").addEventListener("change", function () {
    let sortType = this.value;
    let container = document.getElementById("containerforSort");
    let products = Array.from(container.getElementsByClassName("product-item"));

    products.sort((a, b) => {
        let priceA = parseFloat(a.getAttribute("data-price") || "0");
        let priceB = parseFloat(b.getAttribute("data-price") || "0");
        let titleElemA = a.querySelector(".product-title");
        let titleElemB = b.querySelector(".product-title");
        let nameA = titleElemA ? titleElemA.textContent.trim().toLowerCase() : "";
        let nameB = titleElemB ? titleElemB.textContent.trim().toLowerCase() : "";
        let regularPriceA = parseFloat(a.getAttribute("data-regularprice") || "0");
        let regularPriceB = parseFloat(b.getAttribute("data-regularprice") || "0");
        let dateStrA = a.getAttribute("data-date");
        let dateStrB = b.getAttribute("data-date");
        console.log("Raw Date A:", dateStrA);
        console.log("Raw Date B:", dateStrB);
        let dateA = moment(dateStrA).isValid() ? moment(dateStrA) : null;
        let dateB = moment(dateStrB).isValid() ? moment(dateStrB) : null;
        let offerA = regularPriceA - priceA;
        let offerB = regularPriceB - priceB;
        if (sortType === "lowToHigh") return priceA - priceB;
        if (sortType === "highToLow") return priceB - priceA;
        if (sortType === "ascending") return nameA.localeCompare(nameB);
        if (sortType === "descending") return nameB.localeCompare(nameA);
        if (sortType === "offerprice") return offerB - offerA;
        console.log(`Parsed Date A: ${dateA ? dateA.format() : "Invalid"}`);
        console.log(`Parsed Date B: ${dateB ? dateB.format() : "Invalid"}`);
        if (sortType === "newArrival") {
            if (!dateA) return 1;
            if (!dateB) return -1;
            return dateB.valueOf() - dateA.valueOf();
        }
        return 0;
    });

    
    container.innerHTML = "";
    products.forEach(product => container.appendChild(product));
});


